<style>
.pwrap{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,64px);align-items:start}
@media(max-width:820px){.pwrap{grid-template-columns:1fr}}
.pimg{aspect-ratio:1;border-radius:26px;overflow:hidden;background:linear-gradient(140deg,#1B4332,#0E1A13);display:flex;align-items:center;justify-content:center}
.pimg img{width:100%;height:100%;object-fit:cover}
.pimg .ph{font-family:var(--h);color:rgba(250,249,245,.5);font-size:14px;letter-spacing:.2em;text-transform:uppercase}
.pinfo .vend{font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--signal)}
.pinfo h1{font-weight:600;font-size:clamp(28px,4vw,44px);letter-spacing:-.02em;margin:10px 0 6px}
.price{font-family:var(--h);font-size:24px;font-weight:600;color:var(--forest);margin:8px 0 18px}
.desc{font-size:15px;font-weight:300;line-height:1.75;color:#3c4a42;max-width:52ch}
.desc p{margin-bottom:10px}
.buyrow{display:flex;gap:12px;align-items:center;margin-top:26px;flex-wrap:wrap}
.qty{width:84px;padding:13px;border-radius:999px;border:1.5px solid var(--line);font-family:var(--b);font-size:14px;text-align:center;background:#fff}
.meta{margin-top:26px;padding-top:18px;border-top:1px solid var(--line);font-size:12.5px;color:var(--mut)}
</style>
<div class="pwrap">
  <div class="pimg">
    {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | escape }}">
    {% else %}<span class="ph">Flightlab</span>{% endif %}
  </div>
  <div class="pinfo">
    <div class="vend">{{ product.vendor }}</div>
    <h1>{{ product.title }}</h1>
    <div class="price">{{ product.selected_or_first_available_variant.price | money }}</div>
    <div class="desc">{{ product.description }}</div>
    {% form 'product', product %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <div class="buyrow">
        <input class="qty" type="number" name="quantity" value="1" min="1" aria-label="Antall">
        <button type="submit" class="btn">Legg i handlekurv</button>
        <a class="btn ghost" href="/#discer">← Fortsett å handle</a>
      </div>
    {% endform %}
    <div class="meta">{{ product.type }}{% if product.tags.size > 0 %} · {{ product.tags | join: ' · ' }}{% endif %} · Levering 1–3 dager i Norden</div>
  </div>
</div>
