<style>
.cwrap h1{font-weight:600;font-size:clamp(26px,4vw,40px);letter-spacing:-.02em;margin-bottom:26px}
.line{display:grid;grid-template-columns:72px 1fr auto auto;gap:16px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line)}
.line img{width:72px;height:72px;object-fit:cover;border-radius:14px;background:#0E1A13}
.line .t{font-family:var(--h);font-weight:600;font-size:15.5px}
.line .v{font-size:12px;color:var(--mut);margin-top:3px}
.line .qty{width:70px;padding:9px;border-radius:999px;border:1.5px solid var(--line);text-align:center;font-family:var(--b)}
.line .lp{font-family:var(--h);font-weight:600;color:var(--forest)}
.line .rm{font-size:12px;color:var(--mut);text-decoration:underline}
.csum{margin-top:26px;display:flex;justify-content:flex-end;align-items:center;gap:22px;flex-wrap:wrap}
.csum .tot{font-family:var(--h);font-size:22px;font-weight:600}
.empty{padding:48px 0 24px;color:var(--mut);font-weight:300}
@media(max-width:640px){.line{grid-template-columns:56px 1fr auto}.line .lp{grid-column:3}}
</style>
<div class="cwrap">
<h1>Handlekurv</h1>
{% if cart.item_count == 0 %}
  <p class="empty">Handlekurven er tom.</p>
  <a class="btn" href="/#discer">Se discene →</a>
{% else %}
<form action="/cart" method="post" novalidate>
  {% for item in cart.items %}
  <div class="line">
    {% if item.image %}<img src="{{ item.image | image_url: width: 200 }}" alt="">{% else %}<img alt="">{% endif %}
    <div><div class="t">{{ item.product.title }}</div><div class="v">{{ item.vendor }} · {{ item.price | money }}</div>
      <a class="rm" href="{{ item.url_to_remove }}">Fjern</a></div>
    <input class="qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Antall">
    <div class="lp">{{ item.final_line_price | money }}</div>
  </div>
  {% endfor %}
  <div class="csum">
    <button type="submit" name="update" class="btn ghost" formnovalidate>Oppdater</button>
    <span class="tot">Totalt: {{ cart.total_price | money }}</span>
    <button type="submit" name="checkout" class="btn">Til kassen →</button>
  </div>
</form>
{% endif %}
</div>
