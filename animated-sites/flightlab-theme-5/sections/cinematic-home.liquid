function sizeShards(){
  if(!flshards) return;
  const r=flshards.getBoundingClientRect();
  /* A phone rasterises at 3x; the chips are small, soft and moving, so
     drawing them at 1:1 is invisible and cuts the fill area ninefold. */
  chipScale=matchMedia('(hover:none)').matches?1:Math.min(2,devicePixelRatio||1);
  flshards.width=Math.round(r.width*chipScale);
  flshards.height=Math.round(r.height*chipScale);
}

/* ---- The A ----

   Inter's A is not the A this logo wants. Its apex is cut wide and flat and
   its counter is small and sits low, so at this size the letter reads as a
   blunt wedge next to eight glyphs that are all crisp verticals and clean
   curves. The one drawn here keeps everything that ties it to its neighbours
   and changes only what was wrong with it: the apex is cut to a third of the
   width Inter uses, and the counter opens higher, so the letter carries the
   same triangle of light the rest of the word carries.

   It is drawn into the exact ink box the typed A occupied — same origin, same
   width, same cap height — so nothing around it moves and the proportions
   against L and B are the ones the font chose. Material comes from the layer
   group each path sits in, so all eleven layers reach it the same way they
   reach the letters, and the crystal cannot drift between them.

   Both contours are wound against each other, so the default fill rule cuts
   the counter out rather than needing a rule set on every layer. */
/* Weight first: the diagonals carry the same horizontal mass as the stem of
   the L beside them, which is what stops a drawn letter reading as a lighter
   one. Everything else follows from that — with legs this heavy the counter
   can only be a tall narrow triangle, which is exactly the shape the logo
   wants, and the way to give it room is to drop the crossbar rather than to
   thin the letter. So the bar sits low, at two thirds, and the opening above
   it runs nearly a quarter of the cap height. Against Inter's A — wide flat
   apex, small counter, bar at mid-height — it is a different letter. */
/* Both were overdone at first. An apex cut to a third of Inter's width and a
   bar down at two thirds made a letter that was certainly different and had
   stopped belonging to the eight beside it. The apex is a tenth of the width
   now against Inter's sixth, and the bar has come back up — still lower than
   the font sets it, still a taller counter, but a member of the same word. */
/* Apex ligger paa .035, ikke paa 0. Geometrisk er kapslinjen 0, men bokstaven
   tegnes med de samme brede stroekene som resten av ordet, og et strouk rundt
   en spiss topp rekker hoyere enn et strouk rundt en flat. L og B har flate
   topper og stopper paa linjen; A-en gjorde ikke det, og stakk i luften. .035
   av kapshoyden er omtrent det overskårne overskuddet fra bevelen. */
const FLA_OUT=[[.45,.035],[.55,.035],[1,1],[.755,1],[.65375,.775],[.34625,.775],[.245,1],[0,1]];
const FLA_CNT=[[.5,.4333],[.4115,.63],[.5885,.63]];
/* Radius per corner, in cap units. The apex is barely touched, so its flat
   still reads as a cut rather than a dome; the feet and the counter get more,
   because that is where a real piece of glass is worn round. */
const FLA_ROUT=[.014,.014,.030,.026,.020,.020,.026,.030];
const FLA_RCNT=[.030,.022,.022];
/* A polygon with rounded corners. Each corner is cut back along both edges and
   the corner point becomes the control point of a quadratic, which keeps the
   curve tangent to both runs — the straight parts arrive without a kink, so a
   stroke laid over the result is one continuous polished edge. */
function flPoly(pts,ox,oy,W,C,rr){
  const P=pts.map(q=>[ox+q[0]*W,oy+q[1]*C]),n=P.length,T=[];
  for(let i=0;i<n;i++){
    const p=P[i],a=P[(i+n-1)%n],b=P[(i+1)%n];
    const va=[a[0]-p[0],a[1]-p[1]],vb=[b[0]-p[0],b[1]-p[1]];
    const la=Math.hypot(va[0],va[1])||1,lb=Math.hypot(vb[0],vb[1])||1;
    const d=Math.min(rr[i]*C,la*.45,lb*.45);
    T.push([[p[0]+va[0]/la*d,p[1]+va[1]/la*d],[p[0]+vb[0]/lb*d,p[1]+vb[1]/lb*d]]);
  }
  const f=v=>v.toFixed(2);
  let d='M'+f(T[0][1][0])+' '+f(T[0][1][1]);
  for(let i=1;i<n;i++)
    d+='L'+f(T[i][0][0])+' '+f(T[i][0][1])+'Q'+f(P[i][0])+' '+f(P[i][1])+' '+f(T[i][1][0])+' '+f(T[i][1][1]);
  d+='L'+f(T[0][0][0])+' '+f(T[0][0][1])+'Q'+f(P[0][0])+' '+f(P[0][1])+' '+f(T[0][1][0])+' '+f(T[0][1][1]);
  return d+'Z';
}
/* Cap height and ascent are measured off the ink of an H rather than taken
   from the font size, so both are right whichever face actually rendered.
   getExtentOfChar cannot supply them: it reports the line box, ascender to
   descender, which is half again taller than the cap box and would set the A
   overtopping every letter beside it. */
function flMetrics(font,fs){
  const c=(flMetrics.c||(flMetrics.c=document.createElement('canvas').getContext('2d')));
  c.font=font; c.textBaseline='alphabetic';
  const m=c.measureText('H');
  return {cap:m.actualBoundingBoxAscent||fs*.7031,
          asc:m.fontBoundingBoxAscent||fs*.9031};
}
/* The horizontal fit comes from the font's own advance for the A, so L and B
   keep the spacing the typeface chose; the vertical comes from the measured
   cap line and baseline. The letter therefore stands in exactly the slot the
   typed A stood in, and only its shape has changed. */
function flDrawA(){
  if(!flsvg) return;
  const tx=flsvg.querySelector('.fl-ly text'); if(!tx) return;
  let e; try{e=tx.getExtentOfChar(7)}catch(err){return}
  if(!e||!e.height||!e.width) return;
  /* Kapshoyden maales paa det faktisk rendrede blekket, ikke paa antatte tall.

     Tidligere sto Inters egne forhold hardkodet her. Det er riktig bare hvis
     Inter faktisk er fonten som havner paa skjermen. Den lastes med
     display=swap, saa nettleseren tegner enhetens sans-serif foerst og bytter
     naar Inter kommer - og enhetens sans-serif er ikke den samme paa telefon
     som paa PC. Roboto og SF Pro har lavere kapshoyde enn Inter, saa A-en ble
     tegnet for hoyt i forhold til bokstavene rundt. Det er derfor den svevde
     paa telefon og sto stille paa PC.

     Naa tegnes en enkelt B i den samme beregnede fonten paa et lite canvas, og
     bildepunktene skannes ovenfra til foerste rad med blekk. Det gir kapshoyden
     til den fonten som virkelig brukes i oyeblikket, uten aa vite hvilken det
     er. Slaar maalingen feil, faller vi tilbake paa Inters tall. */
  const cs=getComputedStyle(tx), fs=parseFloat(cs.fontSize);
  let CAP=.727; const ASC=.9688;
  try{
    const R=200, cv=document.createElement('canvas');
    cv.width=R; cv.height=R*2;
    const g=cv.getContext('2d');
    g.font=cs.fontWeight+' '+R+'px '+cs.fontFamily;
    g.textBaseline='alphabetic'; g.fillStyle='#000';
    g.fillText('B', 10, R*1.5);
    const d=g.getImageData(0,0,R,R*2).data;
    let top=-1;
    for(let y=0;y<R*2&&top<0;y++){
      for(let x=0;x<R;x++){ if(d[(y*R+x)*4+3]>40){top=y;break} }
    }
    if(top>0){ const c=(R*1.5-top)/R; if(c>.5&&c<.95) CAP=c; }
  }catch(err){}
  const top=e.y+fs*(ASC-CAP), C=fs*CAP;
  /* 103% og sentrert var for mye av det gode: venstre fot naadde helt bort i
     L-ens fot, og en A hvis fot ligger inntil nabobokstaven leses som om den
     staar inni den. Nede er A-en paa sitt bredeste, saa det er der det merkes.
     96% og forskjovet til hoyre gir klaring paa venstre side uten aa ta borti
     B-en, som staar loddrett og taaler mindre luft. */
  const W=e.width*.96, ox=e.x+e.width*.035;
  const d=flPoly(FLA_OUT,ox,top,W,C,FLA_ROUT)
         +flPoly(FLA_CNT,ox,top,W,C,FLA_RCNT);
  flsvg.querySelectorAll('.fl-a').forEach(n=>n.setAttribute('d',d));
}

/* Fit the wordmark to 70% of the viewport. Inter arrives over the network, so
   its metrics are not known at author time and a hard-coded font-size would
   land wherever the fallback happened to be wide. Measure once the font is in,
   and again after a resize. getBBox is a layout read, so this runs off the
   scroll path entirely. */
const flsvg=document.getElementById('flsvg');
function flFit(){
  if(!flsvg) return;
  const t=flsvg.querySelector('.g-body');
  t.style.fontSize='';                       /* back to the CSS value to measure */
  let w=0; try{w=t.getBBox().width}catch(e){return}
  if(!w) return;
  const cur=parseFloat(getComputedStyle(t).fontSize);
  const px=cur*(innerWidth*0.70)/w;
  /* The size goes on the layer groups, not the text, so every layer's em-based
     stroke width tracks it together. */
  flsvg.querySelectorAll('.fl-ly').forEach(n=>n.style.fontSize=px+'px');
  flDrawA();
}
/* fonts.ready lover bare at nettleseren er ferdig med aa laste det den mente
   den trengte - ikke at Inter i akkurat 800 er klar. Paa PC rekker den det
   uansett; paa telefon, over mobilnett, gjor den det ofte ikke, og da maaler
   flMetrics fallback-fonten mens SVG-en tegner Inter. Ascent spriker, og A-en
   havner i luften. Her bes det eksplisitt om den ene fonten som betyr noe, og
   ordmerket settes paa nytt naar den faktisk er inne. */
if(document.fonts&&document.fonts.ready){document.fonts.ready.then(flFit)}else{flFit()}
if(document.fonts&&document.fonts.load){
  document.fonts.load('800 100px Inter').then(function(){flFit()}).catch(function(){});
}
flFit();
addEventListener('resize',(()=>{let t;return()=>{clearTimeout(t);t=setTimeout(()=>{flFit();sizeShards();buildChips();flBuildDiscs();flDiscParallax(scrollY)},150)}})());
/* Rasterising and sampling the word costs about a frame, so it happens when the
