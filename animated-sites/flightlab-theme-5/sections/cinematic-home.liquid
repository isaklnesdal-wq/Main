function flBuildDiscs(){
  const coarse=matchMedia('(hover:none)').matches;
  const doc=document.documentElement.scrollHeight, vh=innerHeight;
  flLayers.forEach((L,li)=>{
    const n=coarse?Math.max(2,Math.round(L.n*0.5)):L.n;
