  {b:'Kastaplast',m:'Grym X',c:'Distanse',n:[12,5,-1,3],h:'kastaplast-grym-x-distansedriver',p:['K1','K1 Soft','K3'],w:[165,175]},
  {b:'Discraft',m:'Zeus',c:'Distanse',n:[12,5,-1,3],h:'discraft-zeus-distansedriver',p:['ESP','Z','Big Z'],w:[165,175]},
  {b:'Innova',m:'Destroyer',c:'Distanse',n:[12,5,-1,3],h:'innova-destroyer-distansedriver',p:['Star','Champion','DX'],w:[165,175]}
