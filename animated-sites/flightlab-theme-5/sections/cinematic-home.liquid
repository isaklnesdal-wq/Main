<script>
'use strict';
const REDUCED=matchMedia('(prefers-reduced-motion: reduce)').matches;
const TOUCH=matchMedia('(pointer:coarse)').matches;

/* On mobile, transforming a filtered SVG re-rasterises the whole filter
   region every scroll frame — the #1 cause of the bag-zoom jank. Strip the
   turbulence/blur filters on touch so the bag is flat vector = composited,
   no per-frame re-raster. Desktop keeps the full texture + soft shadows. */
if(TOUCH){
  document.querySelectorAll('#bagcap [filter]').forEach(el=>el.removeAttribute('filter'));
}

/* ---- smooth momentum scroll ---- */
let lenis=null;
if(window.Lenis && !REDUCED && !matchMedia('(pointer:coarse)').matches){
  document.documentElement.style.scrollBehavior='auto';
  /* Lerp rather than duration, av samme grunn som for: en fast varighet starter
     paa nytt for hvert hjulhakk og gjor at siden skifter fart under deg.
     Men halen var for lang. .062 er rundt en tredels sekund fra fingeren
     slipper til siden staar stille, og alt som tegnes ut fra scrollen henger
     etter i hele den tiden. Det leses ikke som mykt - det leses som tregt.
     .11 er rundt 90 ms: fortsatt ingen hakk ved retningsskifte, men siden
     folger haanden i stedet for aa hale etter den. Hjulet er heller ikke
     lenger giret ned, saa ett hakk flytter like langt som ellers paa nettet. */
  lenis=new Lenis({lerp:.11,smoothWheel:true,wheelMultiplier:1,touchMultiplier:1.6});
  (function raf(t){lenis.raf(t);requestAnimationFrame(raf)})();
  document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{
    const id=a.getAttribute('href');if(id&&id.length>1&&document.querySelector(id)){e.preventDefault();lenis.scrollTo(id,{duration:1.9,
      easing:t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2})}}));
}

/* ===== Zoom-portal scroll (GPU transforms only → no lag) =====
   A realistic moulded frisbee floats level in the hero, glowing and rocking
   gently. Scrolling levels it out to face you and flies you THROUGH its
   pressed rings (eased scale — slow approach, deep dive) before the bloom
   hands off to the catalogue. A second portal later zooms INTO an
   illustrated disc-golf bag before the bags grid. Only transform and
   opacity are animated — composited on the GPU, no repaint. */
const journey=document.getElementById('journey');
const flenv=document.getElementById('flenv');
let lastEnv='';
const flmark=document.getElementById('flmark');
/* ---- Dissolve ------------------------------------------------------------
   The wordmark is rasterised once, at idle, into a small offscreen canvas. Every
   opaque sample on a grid becomes a chip, and each chip records how far it sat
   from the edge of its letter — that distance becomes its release time, so the
   edges let go first and the interiors last, the way a solid actually comes
   apart. Nothing here runs on the scroll path except the draw. */
const flshards=document.getElementById('flshards');
let CHIPS=null, chipScale=1;
function buildChips(){
  if(!flsvg||!flshards) return;
  const t=flsvg.querySelector('.g-body');
  let bb; try{bb=t.getBBox()}catch(e){return}
  if(!bb.width) return;
  const cs=getComputedStyle(t);
  const RW=420, k=RW/bb.width, RH=Math.max(8,Math.round(bb.height*k))+8;
  const c=document.createElement('canvas'); c.width=RW; c.height=RH;
  const x=c.getContext('2d',{willReadFrequently:true});
