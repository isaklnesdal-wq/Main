/* Hvilket kort som er "det aktive" — brukes bare til telleren, banen som
   lyser og utgangene. Selve skarpheten er kontinuerlig og ligger i flnFocus. */
function flnPaint(i){
  for(let z=0;z<flnFr.length;z++)flnFr[z].classList.toggle('on',z===i);
  if(flnNumEl)flnNumEl.textContent=(i+1<10?'0':'')+(i+1);
  if(flnExitsEl)flnExitsEl.classList.toggle('on',i>=flnFr.length-1);
}
/* Uskarpheten foelger avstanden fra midten som en glidende verdi, ikke som
   en av/paa-klasse. Verdiene rundes foer de skrives, saa et kort som staar
   stille i praksis ikke koster noe: naa er ingen style-invalidering i det
   hele tatt naar ingenting flytter seg. */
function flnFocus(t){
  for(let z=0;z<flnFr.length;z++){
    const d=Math.abs(z-t);
    /* Kort som uansett ligger utenfor skjermkanten faar ingen uskarphet i
       det hele tatt. En blur koster en full ny rastrering av kortet, og det
       var den regningen som gjorde raske skroll tunge — nu betaler vi den
       bare for de tre som faktisk er synlige. Gjennomsiktigheten naar null
       akkurat der grensen gaar, saa ingenting popper naar de faller ut. */
    const far=d>=2.4;
    const bl=far?0:Math.round(Math.min(d*3.2,6)*2)/2;        // 0,5 px-trinn
    const op=far?0:Math.round(Math.max(0,1-d*0.42)*25)/25;   // 0,04-trinn
    const sc=Math.round((1.06-Math.min(d*0.10,.17))*200)/200;
    const key=bl+'|'+op+'|'+sc;
    if(flnKey[z]===key)continue;
    flnKey[z]=key;
    const f=flnFr[z];
    f.style.filter=bl<0.26?'none':'blur('+bl+'px)';
    f.style.opacity=op;
    f.style.transform='scale('+sc+')';
  }
}
