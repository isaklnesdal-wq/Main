/* Real backdrop photo, if one is set in Theme settings. window.FL_SCENE_BG
   is emitted by Shopify as {src, srcset}. The drawn scenery below stays
   put until the photo has decoded, so a slow connection or a broken URL
   degrades to the illustration instead of an empty scene. */
(function(){
  const bg=window.FL_SCENE_BG,img=document.getElementById('scenebg'),scene=document.getElementById('scene');
  if(!bg||!bg.src||!img||!scene)return;
