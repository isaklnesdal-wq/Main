<!-- ===== Hero: real Higgsfield video autoplays; scroll ZOOMS INTO the disc ===== -->
<section id="journey">
  <div class="scene" id="scene">
    <div class="fl-env" id="flenv" aria-hidden="true">
      <div class="fl-caus-a"></div><div class="fl-caus-b"></div>
    </div>
    <!-- Typography intro: no disc, no photo, no scenery. The word is the
         only subject; scrolling dollies the camera into it. -->
    <div class="fl-stage">
      <h1 class="fl-mark" id="flmark" aria-label="FLIGHTLAB">
        <svg class="fl-svg" id="flsvg" aria-hidden="true" focusable="false">
          <defs>
            <!-- The contour where the surface turns away from the light.
                 Not black: crystal picks up the room even in shadow. -->
            <linearGradient id="flDark" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0"   stop-color="#12283A" stop-opacity=".16"/>
              <stop offset=".42" stop-color="#0E2032" stop-opacity=".24"/>
              <stop offset="1"   stop-color="#12283A" stop-opacity=".18"/>
            </linearGradient>
            <!-- Refraction. userSpaceOnUse, so this is measured against the
                 viewport rather than the glyph: it restates the light behind the
                 word, displaced sideways — what you see through a thick solid is
                 the backdrop moved, not the backdrop lined up behind it. Kept
                 very low: the centre of a letter is supposed to be almost clear,
                 so this may only tint what is already there. -->
            <linearGradient id="flRefr" gradientUnits="userSpaceOnUse" x1="8%" y1="0" x2="96%" y2="0">
              <stop offset="0"   stop-color="#7CFFD4" stop-opacity=".022"/>
              <stop offset=".30" stop-color="#5FE8FF" stop-opacity=".034"/>
              <stop offset=".52" stop-color="#CFF4FF" stop-opacity=".036"/>
              <stop offset=".68" stop-color="#B08CFF" stop-opacity=".022"/>
              <stop offset=".82" stop-color="#6FE6FF" stop-opacity=".030"/>
              <stop offset="1"   stop-color="#8CFFD0" stop-opacity=".018"/>
            </linearGradient>
            <!-- Body tint. The specified progression, but at the alpha of a
                 clear solid: the interior carries the colour, it does not become
                 the colour. -->
            <linearGradient id="flBody" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0"   stop-color="#F8FCFF" stop-opacity=".030"/>
              <stop offset=".22" stop-color="#EEF9FF" stop-opacity=".008"/>
              <stop offset=".50" stop-color="#DDF6FF" stop-opacity=".004"/>
              <stop offset=".74" stop-color="#C6F2F8" stop-opacity=".008"/>
              <stop offset="1"   stop-color="#AEEFF5" stop-opacity=".028"/>
            </linearGradient>
            <!-- Light gathered through the solid and released at the base. -->
            <linearGradient id="flCaus" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0"    stop-color="#FFFFFF" stop-opacity="0"/>
              <stop offset=".64"  stop-color="#FFFFFF" stop-opacity="0"/>
              <stop offset=".79"  stop-color="#C6F2F8" stop-opacity=".12"/>
              <stop offset=".88"  stop-color="#B8FFD9" stop-opacity=".16"/>
              <stop offset=".95"  stop-color="#DDF6FF" stop-opacity=".34"/>
              <stop offset="1"    stop-color="#F8FCFF" stop-opacity=".52"/>
            </linearGradient>
            <!-- The bevel. This is where the material actually lives: the whole
                 specified progression at full strength, because the edges are
                 what carry the reflections while the centre stays clear. All of
                 it on one cool axis: a polished edge picks up the room it is
                 standing in, and this room is not green. -->
            <linearGradient id="flBevel" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0"   stop-color="#FFFFFF" stop-opacity="1"/>
              <stop offset=".12" stop-color="#F6FDFF" stop-opacity=".82"/>
              <stop offset=".34" stop-color="#DDF6FF" stop-opacity=".26"/>
              <stop offset=".56" stop-color="#C6F2F8" stop-opacity=".30"/>
              <stop offset=".74" stop-color="#B8FFD9" stop-opacity=".24"/>
              <stop offset=".88" stop-color="#D6F7FC" stop-opacity=".70"/>
              <stop offset="1"   stop-color="#C4F4F9" stop-opacity=".94"/>
            </linearGradient>
            <linearGradient id="flValley" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0"   stop-color="#0F2634" stop-opacity=".32"/>
              <stop offset=".5"  stop-color="#14313E" stop-opacity=".16"/>
              <stop offset="1"   stop-color="#0F2634" stop-opacity=".26"/>
            </linearGradient>
            <!-- Specular, confined to the top of the form. Transparent below a
                 fifth of the height, so the highlight sits where a light points
                 instead of ringing the whole letter. -->
            <linearGradient id="flSpec" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0"    stop-color="#FFFFFF" stop-opacity="1"/>
              <stop offset=".10"  stop-color="#F8FCFF" stop-opacity=".86"/>
              <stop offset=".19"  stop-color="#EEF9FF" stop-opacity=".12"/>
              <stop offset=".24"  stop-color="#FFFFFF" stop-opacity="0"/>
              <stop offset=".90"  stop-color="#FFFFFF" stop-opacity="0"/>
              <stop offset="1"    stop-color="#DDF6FF" stop-opacity=".34"/>
            </linearGradient>
            <!-- Colour that only exists on the edge. Real crystal turns hardest
                 where it is thickest — the edges and corners — so this is a
                 stroke, not a fill, and can never appear across a flat face.
                 It used to run a full spectrum along the word, which put pink
                 and violet on a letter standing in a blue room. What varies now
                 is depth of the same cool tint, not hue: the word still shifts
                 as your eye travels it, without ever announcing a colour. -->
            <linearGradient id="flIris" gradientUnits="userSpaceOnUse" x1="6%" y1="20%" x2="94%" y2="80%">
              <stop offset="0"    stop-color="#5A8CFF" stop-opacity=".13"/>
              <stop offset=".21"  stop-color="#78F0FF" stop-opacity=".18"/>
              <stop offset=".43"  stop-color="#FFB4D7" stop-opacity=".12"/>
              <stop offset=".63"  stop-color="#AA82FF" stop-opacity=".14"/>
              <stop offset=".83"  stop-color="#6EFFC8" stop-opacity=".11"/>
              <stop offset="1"    stop-color="#5A8CFF" stop-opacity=".12"/>
            </linearGradient>
            <linearGradient id="flGloss" x1="0" y1="0" x2=".65" y2="1">
              <stop offset="0"    stop-color="#FFFFFF" stop-opacity=".30"/>
              <stop offset=".16"  stop-color="#F2FCFF" stop-opacity=".21"/>
              <stop offset=".33"  stop-color="#DDF6FF" stop-opacity=".05"/>
              <stop offset=".44"  stop-color="#FFFFFF" stop-opacity="0"/>
              <stop offset=".62"  stop-color="#FFFFFF" stop-opacity="0"/>
              <stop offset=".74"  stop-color="#C6F2F8" stop-opacity=".10"/>
              <stop offset=".88"  stop-color="#EAFBFF" stop-opacity=".26"/>
              <stop offset="1"    stop-color="#FFFFFF" stop-opacity=".34"/>
            </linearGradient>
            <!-- The reflection's falloff. The layer is flipped, so the end of
                 this ramp is the contact line where the word meets the floor and
                 the start of it is the far end. It used to be close to linear,
                 which is why the reflection ran the full height of the letters
                 and then stopped at an edge. A real one loses almost everything
                 in the first third: bright where the two touch, gone well before
                 it has finished. -->
            <linearGradient id="flReflGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0"   stop-color="#000000"/>
              <stop offset=".20" stop-color="#000000"/>
              <stop offset=".42" stop-color="#1C1C1C"/>
              <stop offset=".62" stop-color="#585858"/>
              <stop offset=".84" stop-color="#B2B2B2"/>
              <stop offset="1"   stop-color="#FFFFFF"/>
            </linearGradient>
            <mask id="flReflFade" maskContentUnits="objectBoundingBox">
              <rect x="0" y="0" width="1" height="1" fill="url(#flReflGrad)"/>
            </mask>
          </defs>
          <!-- One group per layer, each holding the typed letters and the drawn
               A. Every material property — fill, stroke, gradient, width, mask
               and transform — is set on the group, so both reach the letter the
               same way and the A cannot drift from the rest of the word. -->
          <g class="fl-ly g-ext"   ><text x="50%" y="50%" text-anchor="middle" dominant-baseline="central">FLIGHTL<tspan class="a-slot">A</tspan>B</text><path class="fl-a" d=""/></g>
          <g class="fl-ly g-dark"  ><text x="50%" y="50%" text-anchor="middle" dominant-baseline="central">FLIGHTL<tspan class="a-slot">A</tspan>B</text><path class="fl-a" d=""/></g>
          <g class="fl-ly g-refr"  ><text x="50%" y="50%" text-anchor="middle" dominant-baseline="central">FLIGHTL<tspan class="a-slot">A</tspan>B</text><path class="fl-a" d=""/></g>
          <g class="fl-ly g-body"  ><text x="50%" y="50%" text-anchor="middle" dominant-baseline="central">FLIGHTL<tspan class="a-slot">A</tspan>B</text><path class="fl-a" d=""/></g>
          <g class="fl-ly g-gloss" ><text x="50%" y="50%" text-anchor="middle" dominant-baseline="central">FLIGHTL<tspan class="a-slot">A</tspan>B</text><path class="fl-a" d=""/></g>
          <g class="fl-ly g-caus"  ><text x="50%" y="50%" text-anchor="middle" dominant-baseline="central">FLIGHTL<tspan class="a-slot">A</tspan>B</text><path class="fl-a" d=""/></g>
          <g class="fl-ly g-iris"  ><text x="50%" y="50%" text-anchor="middle" dominant-baseline="central">FLIGHTL<tspan class="a-slot">A</tspan>B</text><path class="fl-a" d=""/></g>
          <g class="fl-ly g-bevel" ><text x="50%" y="50%" text-anchor="middle" dominant-baseline="central">FLIGHTL<tspan class="a-slot">A</tspan>B</text><path class="fl-a" d=""/></g>
          <g class="fl-ly g-valley"><text x="50%" y="50%" text-anchor="middle" dominant-baseline="central">FLIGHTL<tspan class="a-slot">A</tspan>B</text><path class="fl-a" d=""/></g>
          <g class="fl-ly g-spec"  ><text x="50%" y="50%" text-anchor="middle" dominant-baseline="central">FLIGHTL<tspan class="a-slot">A</tspan>B</text><path class="fl-a" d=""/></g>
          <g class="fl-ly g-refl"  ><text x="50%" y="50%" text-anchor="middle" dominant-baseline="central">FLIGHTL<tspan class="a-slot">A</tspan>B</text><path class="fl-a" d=""/></g>
        </svg>
      </h1>
    </div>
    <canvas class="fl-shards" id="flshards" aria-hidden="true"></canvas>
    <div class="grain"></div>
    <div id="loader"><div class="ln"></div><div class="brand">FLIGHTLAB</div><div class="ln"></div></div>

