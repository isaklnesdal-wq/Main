  for(let i=0;i<CHIPS.length;i++){
    const c=CHIPS[i];
    const t=(q-c.rel)/(1-c.rel);
    if(t<=0) continue;
    const e=t*t*t;                                /* barely moves, then leaves */
    const px=c.x*scale+c.vx*drift*e+cx;
    const py=c.y*scale+c.vy*drift*e+cy;
