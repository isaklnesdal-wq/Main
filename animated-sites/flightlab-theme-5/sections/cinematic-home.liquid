const clamp=(a,b,v)=>Math.max(a,Math.min(b,v));
const smooth=p=>p<=0?0:p>=1?1:p*p*(3-2*p);
function secP(el){const r=el.getBoundingClientRect();return clamp(0,1,-r.top/(r.height-innerHeight))}

