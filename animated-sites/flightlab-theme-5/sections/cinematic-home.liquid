  if('letterSpacing' in x) x.letterSpacing=(parseFloat(cs.fontSize)*k*-0.045)+'px';
  x.textAlign='left'; x.textBaseline='middle'; x.fillStyle='#fff';
  /* One call for the whole word, set from the same advances the browser would
     have used, so the chips come apart out of exactly the shape on screen. */
  const left=RW/2-x.measureText('FLIGHTLAB').width/2;
  x.fillText('FLIGHTLAB',left,RH/2);
  const px=x.getImageData(0,0,RW,RH).data;
  const on=(ix,iy)=>ix>=0&&iy>=0&&ix<RW&&iy<RH&&px[((iy*RW+ix)<<2)+3]>110;
