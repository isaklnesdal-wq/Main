/* ---- Floating system ----
   Discs are laid out down the whole document, then each layer is offset against
   the scroll by its own factor. A disc at document position T shows up on screen
   at T - k*scrollY, so a layer needs to cover vh + k*(doc - vh); spacing them
   over exactly that range is what keeps discs entering and leaving continuously
   instead of resetting anywhere. */
const flLayers=[...document.querySelectorAll('.fl-layer')].map(el=>({
  el, k:parseFloat(el.dataset.k), n:parseInt(el.dataset.n,10), l:el.dataset.l}));
