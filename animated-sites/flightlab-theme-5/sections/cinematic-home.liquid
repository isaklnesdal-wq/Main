/* Backdrop: a hazy forest fairway with a low sun and a disc-golf basket
   standing under the disc. Built once as static SVG — it is never
   transformed while scrolling, so the whole scene costs a single paint.
   The realism comes from atmospheric perspective rather than detail:
   distant layers are pale and low-contrast, near layers darker and
   coarser, with mist banding between them. */
(function(){
  const sc=document.getElementById('scape');if(!sc)return;
  const W=1440,H=620;
  let seed=23;const rnd=()=>(seed=(seed*16807)%2147483647)/2147483647;
  const R=(a,b)=>a+rnd()*(b-a);
  /* whole viewBox units: the scape renders at roughly 0.9 px per unit, so
     sub-pixel precision only inflates the markup */
  const f=n=>n.toFixed(0);

  /* A spruce built from tiered, drooping branches with per-tier jitter,
     so the silhouette breaks up the way a real conifer does instead of
     reading as the plain triangle this used to draw. */
  function spruce(x,base,h,w,lean){
    const tiers=Math.round(R(9,14)),top=base-h;
    let right='',left='';
    for(let i=1;i<=tiers;i++){
      const t=i/tiers;
      const y=top+h*Math.pow(t,0.94);
      const hw=w*Math.pow(t,0.8)*R(0.84,1.14);
      const cx=x+lean*Math.pow(1-t,2)*h*0.1;
      const droop=h*0.024*R(0.5,1.4);
      const notch=R(0.42,0.62),step=h*0.042;
      right+=' L'+f(cx+hw)+' '+f(y+droop)+' L'+f(cx+hw*notch)+' '+f(y+step);
      left=' L'+f(cx-hw*notch)+' '+f(y+step)+' L'+f(cx-hw)+' '+f(y+droop)+left;
    }
    const tw=Math.max(1.2,w*0.1);
    return 'M'+f(x)+' '+f(top)+right+' L'+f(x+tw)+' '+f(base)+' L'+f(x-tw)+' '+f(base)+left+' Z';
  }

  /* A broadleaf — lumpy canopy on a short trunk, mixed in for variety so
     the treeline isn't uniformly coniferous. */
  function broadleaf(x,base,h,w){
    const n=11,cy=base-h*0.6,rx=w*0.5,ry=h*0.44,pts=[];
    for(let i=0;i<n;i++){
      const a=Math.PI*2*i/n,k=R(0.9,1.09);
      pts.push([x+Math.cos(a)*rx*k,cy+Math.sin(a)*ry*k]);
    }
    /* round each span outwards into a lobe, so the canopy reads as foliage
       instead of the angular boulder a straight-edged polygon gives */
    let d='M'+f(pts[0][0])+' '+f(pts[0][1]);
    for(let i=1;i<=n;i++){
      const p=pts[i%n],q=pts[i-1];
      const mx=(q[0]+p[0])*0.5,my=(q[1]+p[1])*0.5;
      d+=' Q'+f(x+(mx-x)*1.3)+' '+f(cy+(my-cy)*1.3)+' '+f(p[0])+' '+f(p[1]);
    }
    const tw=Math.max(1.4,w*0.045),ty=cy+ry*0.55;
    return d+' Z M'+f(x-tw)+' '+f(base)+' L'+f(x-tw*0.5)+' '+f(ty)+
      ' L'+f(x+tw*0.5)+' '+f(ty)+' L'+f(x+tw)+' '+f(base)+' Z';
  }

  /* One band of forest. Trees are split across three sub-paths drawn at
     different opacities: individual trees then sit at slightly different
     depths in the haze instead of forming one flat cut-out wall. Still
     only three paths per band, so it stays cheap. */
  function band(baseY,hMin,hMax,wRatio,count,broadChance){
    const tone=['','',''];
    for(let i=0;i<count;i++){
      /* clustered rather than evenly spaced — real treelines clump */
      const x=-50+(W+100)*(i+R(-0.55,0.55))/count;
      const h=R(hMin,hMax)*(rnd()<0.22?R(1.15,1.4):1);   // occasional tall one
      const b=baseY+R(-5,5);
      const t=rnd()<0.5?0:(rnd()<0.5?1:2);
      tone[t]+=(broadChance&&rnd()<broadChance)
        ? broadleaf(x,b,h*0.74,h*wRatio*1.7)
        : spruce(x,b,h,h*wRatio,R(-1,1));
    }
    return tone;
  }
  const layer=(t,fill)=>'<path d="'+t[0]+'" fill="'+fill+'"/>'+
    '<path d="'+t[1]+'" fill="'+fill+'" opacity=".82"/>'+
    '<path d="'+t[2]+'" fill="'+fill+'" opacity=".66"/>';

  /* Low scrub along a treeline base, so the trees don't meet the grass on
     a ruler-straight line. */
  function scrub(baseY,h,count){
    let d='';
    for(let i=0;i<count;i++){
      const x=-40+(W+80)*(i+R(-0.5,0.5))/count;
      const hh=h*R(0.55,1.5),w=hh*R(1.7,3.2);
      d+='M'+f(x-w*0.5)+' '+f(baseY);
      for(let j=0;j<=7;j++){
        const a=Math.PI*(1-j/7);
        d+=' L'+f(x+Math.cos(a)*w*0.5*R(0.9,1.06))+' '+f(baseY-Math.sin(a)*hh*R(0.68,1.18));
      }
      d+=' Z';
    }
    return d;
  }

  /* Scattered grass tufts on the fairway. */
  function tufts(y0,y1,count){
    let d='';
    for(let i=0;i<count;i++){
      const x=R(-20,W+20),y=R(y0,y1),s=R(2.5,6)*(0.6+(y-y0)/(y1-y0));
      d+='M'+f(x)+' '+f(y)+' L'+f(x+s*0.35)+' '+f(y-s*1.9)+' L'+f(x+s*0.9)+' '+f(y)+' Z';
    }
    return d;
  }

  /* Smooth rolling hills far behind the trees. */
  function hill(y0,amp,fr,ph){
    let d='M0 '+H+' L0 '+f(y0);
    for(let x=0;x<=W;x+=40){
      const u=x/W*Math.PI;
      d+=' L'+f(x)+' '+f(y0-amp*(0.5+0.5*Math.sin(u*fr+ph))-amp*0.26*Math.sin(u*fr*2.7+ph*1.7));
    }
    return d+' L'+W+' '+H+' Z';
  }

  /* The basket, drawn in local coordinates with the ground contact at
     (0,0) and everything else above it, then placed under the disc. */
  function basket(){
    let chains='',slats='';
    for(let i=0;i<16;i++){
      const a=Math.PI*2*i/16,front=Math.sin(a)>0;
      const x0=Math.cos(a)*52,y0=-168+Math.sin(a)*8;
      const x1=Math.cos(a)*30,y1=-68+Math.sin(a)*4;
      chains+='<path d="M'+f(x0)+' '+f(y0)+' Q'+f((x0+x1)*0.5*1.08)+' '+f((y0+y1)*0.5)+' '+f(x1)+' '+f(y1)+'"'+
        ' stroke="'+(front?'#eef3ea':'#9fb3a5')+'" stroke-width="'+(front?1.5:1)+'" fill="none"'+
        ' opacity="'+(front?0.88:0.45)+'"/>';
    }
    for(let i=0;i<=12;i++){
      const a=Math.PI*i/12;
      slats+='<path d="M'+f(-58*Math.cos(a))+' -58 L'+f(-45*Math.cos(a))+' -16"'+
        ' stroke="#22392a" stroke-width="1.5" opacity=".75"/>';
    }
    return '<g transform="translate(720 566) scale(.9)">'+
      '<ellipse cx="-16" cy="5" rx="66" ry="11" fill="#2c5133" opacity=".32"/>'+
      '<rect x="-5" y="-176" width="10" height="170" rx="3" fill="url(#gPole)"/>'+
      '<path d="M-58 -58 L-45 -16 A45 7 0 0 0 45 -16 L58 -58 Z" fill="url(#gCage)"/>'+
      '<g fill="none">'+slats+'</g>'+
      '<ellipse cx="0" cy="-16" rx="45" ry="7" fill="none" stroke="#1d3325" stroke-width="2.4"/>'+
      '<ellipse cx="0" cy="-58" rx="58" ry="9" fill="none" stroke="#2c4835" stroke-width="5"/>'+
      '<ellipse cx="0" cy="-59.5" rx="58" ry="9" fill="none" stroke="#c3d6c6" stroke-width="1.5" opacity=".65"/>'+
      chains+
      '<ellipse cx="0" cy="-168" rx="52" ry="8" fill="none" stroke="#2c4835" stroke-width="4.5"/>'+
      '<ellipse cx="0" cy="-169.5" rx="52" ry="8" fill="none" stroke="#c3d6c6" stroke-width="1.4" opacity=".6"/>'+
      '<path d="M-21 -170 L0 -191 L21 -170 Z" fill="#2a4433"/>'+
      '</g>';
  }

  const defs='<defs>'+
    '<linearGradient id="gHill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#dbe8de"/><stop offset="1" stop-color="#c1d6ca"/></linearGradient>'+
    '<linearGradient id="gFar" x1="0" y1="0" x2=".3" y2="1"><stop offset="0" stop-color="#cadfd1"/><stop offset="1" stop-color="#a9c7b8"/></linearGradient>'+
    '<linearGradient id="gMid" x1="0" y1="0" x2=".3" y2="1"><stop offset="0" stop-color="#93b797"/><stop offset="1" stop-color="#628a6e"/></linearGradient>'+
    '<linearGradient id="gNear" x1="0" y1="0" x2=".3" y2="1"><stop offset="0" stop-color="#578266"/><stop offset="1" stop-color="#32543e"/></linearGradient>'+
    '<linearGradient id="gFore" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2e4b37"/><stop offset="1" stop-color="#1b3123"/></linearGradient>'+
    '<linearGradient id="gGround" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a3c583"/><stop offset=".45" stop-color="#83ac6b"/><stop offset="1" stop-color="#5b8350"/></linearGradient>'+
    '<linearGradient id="gPole" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#22382a"/><stop offset=".42" stop-color="#54705b"/><stop offset="1" stop-color="#1b2f22"/></linearGradient>'+
    '<linearGradient id="gCage" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#294331"/><stop offset=".46" stop-color="#3f6048"/><stop offset="1" stop-color="#1f3527"/></linearGradient>'+
    '<linearGradient id="gMist" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#f4faf6" stop-opacity=".8"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>'+
    '</defs>';

  sc.innerHTML='<svg viewBox="0 0 '+W+' '+H+'" preserveAspectRatio="xMidYMax slice">'+defs+
    /* distant hills, hazed almost into the sky */
    '<path d="'+hill(276,40,1.7,0.6)+'" fill="url(#gHill)" opacity=".78"/>'+
    '<path d="'+hill(304,28,2.4,2.1)+'" fill="#bfd5c8" opacity=".82"/>'+
    '<rect x="0" y="252" width="'+W+'" height="86" fill="url(#gMist)" opacity=".9"/>'+
    /* far treeline */
    layer(band(336,58,98,0.19,52,0.18),'url(#gFar)')+
    '<path d="'+scrub(340,11,60)+'" fill="url(#gFar)" opacity=".8"/>'+
    '<rect x="0" y="300" width="'+W+'" height="74" fill="url(#gMist)" opacity=".68"/>'+
    /* mid treeline */
    layer(band(396,92,152,0.2,36,0.2),'url(#gMid)')+
    '<path d="'+scrub(400,16,46)+'" fill="url(#gMid)" opacity=".85"/>'+
    '<rect x="0" y="360" width="'+W+'" height="64" fill="url(#gMist)" opacity=".45"/>'+
    /* near treeline */
    layer(band(450,132,214,0.21,25,0.22),'url(#gNear)')+
    '<path d="'+scrub(452,24,34)+'" fill="url(#gNear)"/>'+
    /* sunlit fairway */
    '<path d="M0 444 Q360 432 720 440 Q1080 448 1440 436 L'+W+' '+H+' L0 '+H+' Z" fill="url(#gGround)"/>'+
    '<ellipse cx="700" cy="470" rx="520" ry="26" fill="#b3d191" opacity=".3"/>'+
    '<ellipse cx="760" cy="522" rx="600" ry="34" fill="#9cc07d" opacity=".26"/>'+
    '<ellipse cx="300" cy="500" rx="420" ry="22" fill="#6f9a5c" opacity=".22"/>'+
    '<ellipse cx="1150" cy="560" rx="480" ry="30" fill="#6f9a5c" opacity=".2"/>'+
    '<path d="'+tufts(452,H,190)+'" fill="#4f7a45" opacity=".4"/>'+
    basket()+
    /* foreground framing trees, cropped by the edges of the frame */
    '<path d="'+spruce(46,700,430,74,0.4)+spruce(-26,700,360,62,-0.3)+
      spruce(1396,700,450,78,-0.4)+spruce(1466,700,380,66,0.3)+'" fill="url(#gFore)"/>'+
    '</svg>';
})();

/* Rasterising the bag SVG is the heaviest thing on this page, and the cost
   grows with how far it is scaled up — vector art is re-rastered at each
   new scale, unlike the hero photo. Cap the zoom lower on phones. */
const ZHERO=TOUCH?7:11;

/* ---- Geometry cache ------------------------------------------------------
   The scroll loop used to call getBoundingClientRect() on the hero and on the
   bag portal, and read documentElement.scrollHeight, on every single frame —
   and it did so *after* it had already written transforms and opacities. Each
   of those reads therefore forced a synchronous layout to flush the pending
   writes. Measured on a phone at 6x throttle: 1.32 layouts and 3.70 style
   recalculations per frame across a full-page scroll, which is exactly what a
   sticky scroll feels like.

   None of these values change while you scroll. They are read once here and
   refreshed only when something can actually move them, and the loop derives
   everything it needs from scrollY, which is free. */
const GEO={jTop:0,jH:0,max:1,vh:0};
function flGeom(){
  GEO.vh=innerHeight;
  const y=scrollY;
  if(journey){const r=journey.getBoundingClientRect();GEO.jTop=r.top+y;GEO.jH=r.height}
  GEO.max=Math.max(1,document.documentElement.scrollHeight-GEO.vh);
}
flGeom();
/* Park the hero's atmosphere whenever the hero is not on screen. */
if(journey&&'IntersectionObserver' in window){
  new IntersectionObserver(es=>{
    document.documentElement.classList.toggle('hero-off',!es[0].isIntersecting);
  },{rootMargin:'10% 0px'}).observe(journey);
}
addEventListener('resize',(()=>{let t;return()=>{clearTimeout(t);t=setTimeout(flGeom,150)}})());
addEventListener('load',flGeom);
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(flGeom);
let lastProg='',lastPar=-1;
let lastKey='';
function loop(){
  // Only touch the hero when its section is actually on screen — avoids
  // writing transforms every frame while the user is down in the catalogue.
  const _y=scrollY;                       // one cheap read, no layout forced
  const jTop=GEO.jTop-_y;
  if(jTop+GEO.jH>0 && jTop<GEO.vh){
    const pRaw=clamp(0,1,-jTop/(GEO.jH-GEO.vh||1));
    /* HOLD. For the first stretch after load the piece simply sits there and
       nothing responds to the wheel — long enough to look at the material
       before touching anything. Afterwards the shown position eases toward the
       real scroll position rather than snapping to it, so however far someone
       scrolled during the hold, the camera still starts from rest and arrives
       without a step. */
    if(!flArmed) pShown=0;
    else pShown += (pRaw-pShown)*0.10;
    const p=pShown;
    const e=smooth(p);
    /* Dolly, not scale. We pick the apparent size we want, then solve for the
       camera distance that produces it, so the growth carries real
       perspective and the type stays type. */
    const s=1+Math.pow(e,1.45)*ZHERO;
    const z=PERSP*(1-1/s);
    /* A flat plane under a perspective transform projects to a plain uniform
       scale — mathematically it cannot look like anything else, which is why
       the pure dolly still read as zooming. Giving the word a small yaw as the
       camera closes puts its two ends at different depths, so the near end
       grows faster than the far end. That difference is parallax, and parallax
       is the thing the eye reads as travelling rather than scaling. Both start
       at zero, so the piece is perfectly frontal while it is being looked at. */
    /* The yaw is a desktop-only cue. A 3D-rotated element takes a different
       raster path, which measured as the dominant new cost on a phone, and at
       phone size the parallax it buys spans a few pixels. Touch keeps the pure
       dolly. */
    const yaw=TOUCH?0:(6.4*e);
    const dx=(TOUCH?0:-3.1*e*innerWidth/100);
    if(flmark){
      const moving=p>0.006;
      if(moving!==flMoving){flMoving=moving;flmark.classList.toggle('fl-moving',moving)}
      flmark.style.transform=TOUCH
        ? 'translate3d(0,0,'+z.toFixed(2)+'px)'
        : 'translate3d('+dx.toFixed(1)+'px,0,'+z.toFixed(2)+'px) rotateY('+yaw.toFixed(2)+'deg)';
      /* The word hands over to the chips rather than simply fading: it clears
         while the field is still dense, so what you watch leave is crystal. */
      /* Dissolve the hero's own environment as the intro ends, so the join
         with the catalogue is the page field meeting itself. */
      /* Written on the environment layer itself, and only when it actually
         changes. Setting a custom property on .scene invalidated style for
         every node in the hero, every frame. */
      if(flenv){const ev=(1-smooth(clamp(0,1,(p-0.50)/0.28))).toFixed(2);
        if(ev!==lastEnv){lastEnv=ev;flenv.style.opacity=ev}}
      const q=smooth(clamp(0,1,(p-0.44)/0.52));
      flmark.style.opacity=(1-smooth(clamp(0,1,(p-0.42)/0.32))).toFixed(3);
      if(flshards){
        if(q>0){
          if(flshards.style.opacity!=='1') flshards.style.opacity='1';
          drawChips(q,s,flshards.width/chipScale/2+dx,flshards.height/chipScale/2);
        }else if(flshards.style.opacity!=='0'){
          flshards.style.opacity='0';
          drawChips(0,s,0,0);
        }
      }
    }
    const key=p.toFixed(3);
    if(key!==lastKey){lastKey=key;
      caps.forEach(c=>{const s=+c.dataset.show,h=+c.dataset.hide;c.classList.toggle('show',p>=s&&p<h)});
      if(cue)cue.style.opacity=p>0.05?'0':'0.7';}
  }
  // Fluktbanen. Én bane tegnes med stroke-dashoffset; hvor langt den har
  // kommet er svaret paa hvilken disc du trenger. Discen rir paa hodet av
  // banen og roteres etter tangenten, saa den peker dit den faktisk flyr.
  if(flySec && flyPaths.length){
    const fr=flySec.getBoundingClientRect();
    if(fr.bottom>0 && fr.top<innerHeight){
      const fp=clamp(0,1,-fr.top/(fr.height-innerHeight));
      const q=Math.round(clamp(0,1,(fp-0.06)/0.80)*400)/400;
      if(q!==flyLast){
        flyLast=q;
        for(let i=0;i<flyPaths.length;i++)flyPaths[i].style.strokeDashoffset=(flyLen*(1-q)).toFixed(1);
        if(flyNum)flyNum.textContent=Math.round(2+q*12);
        if(flyDisc){
          if(q>0.004){
            const a=flyPaths[0].getPointAtLength(flyLen*q);
            const b2=flyPaths[0].getPointAtLength(Math.max(0,flyLen*q-6));
            const ang=Math.atan2(a.y-b2.y,a.x-b2.x)*180/Math.PI+90;
            flyDisc.setAttribute('transform','translate('+a.x.toFixed(1)+' '+a.y.toFixed(1)+') rotate('+ang.toFixed(1)+')');
            flyDisc.classList.add('on');
          } else flyDisc.classList.remove('on');
        }
        let fa=-1;
        for(let j=0;j<flyRows.length;j++)if(q>=+flyRows[j].dataset.at)fa=j;
        for(let k3=0;k3<flyRows.length;k3++)flyRows[k3].classList.toggle('on',k3===fa);
        if(flyCta)flyCta.classList.toggle('on',q>0.12);
      }
    }
  }
  // Filmstrimmelen. Scrollen mater filmen sidelengs, og bare bildet som
  // staar i porten er opplyst. Transformen skrives bare naar den endrer
  // seg, og rammene bytter tilstand paa hele bilder — ikke per piksel.
  if(flnSec && flnFr.length){
    const mr=flnSec.getBoundingClientRect();
    if(mr.bottom>0 && mr.top<innerHeight){
      const mp=clamp(0,1,-mr.top/(mr.height-innerHeight||1));
      const n=flnFr.length-1;
      /* Scrollen bestemmer bare HVILKET kort som er maalet — ett hakk, ett
         kort. Selve forflytningen er en egen animasjon med fast lengde som
         gaar sin gang uansett hva scrollen gjoer imens. Det var her det
         hakket foer: da laa posisjonen rett paa scrollposisjonen, og naar du
         drar fort flytter den seg i store sprang, saa raden hoppet like
         hardt som fingeren din. Naa ser en rask gjennomgang lik ut som en
         rolig — den bare faar kortere vei aa hente inn. */
      const goal=Math.round(clamp(0,1,(mp-0.07)/0.86)*n);
      const now=performance.now();
      if(goal!==flnGoal){
        flnFrom=flnPos; flnGoal=goal; flnT0=now;
        flnDur=320+130*Math.min(3,Math.abs(goal-flnFrom));
        flnShown=goal; flnPaint(goal);
      }
      if(flnPos!==flnGoal){
        const k=clamp(0,1,(now-flnT0)/flnDur);
        flnPos=k>=1?flnGoal:flnFrom+(flnGoal-flnFrom)*(1-Math.pow(1-k,3));
        flnFocus(flnPos);
        if(flnStride&&flnRail){
          const px=(-(flnPos*flnStride)).toFixed(1);
          if(px!==flnLastX){flnLastX=px;flnRail.style.transform='translate3d('+px+'px,0,0)'}
          /* Rammen sitter paa maalkortet, ikke paa midten. I det maalet
             skifter, hopper den rett over til det nye kortet der det staar,
             og foelger det inn til midten. Den kan altsaa ikke bli staaende
             og ramme inn to halve kort — den er alltid rundt ett. */
          if(flnGate){
            const gx=((flnGoal-flnPos)*flnStride).toFixed(1);
            if(gx!==flnLastG){flnLastG=gx;
              flnGate.style.transform='translate(-50%,-50%) translate3d('+gx+'px,0,0)'}
          }
        }
      }
    }
  }
  // Kapasitetsvelgeren. Scrollen setter et MAAL, og telleren gaar mot maalet
  // i steg paa noeyaktig én disc med et gulv paa hvor fort den kan gaa. Da
  // lander hver disc for seg selv, i stedet for at et helt knippe dukker opp
  // samtidig fordi ett hjulhakk daekker flere plasser. Scroller du fort,
  // kortes ventetiden ned saa telleren henter seg inn uten aa henge etter.
  if(capSec && capDiscs.length){
    const cr=capSec.getBoundingClientRect();
    if(cr.bottom>0 && cr.top<innerHeight){
      const cp=clamp(0,1,-cr.top/(cr.height-innerHeight));
      capTarget=Math.round(clamp(0,1,(cp-0.04)/0.90)*capDiscs.length);
    }
    if(capShown!==capTarget){
      const d=Math.abs(capTarget-capShown);
      const wait=d>12?15:(d>6?32:68);
      const now=performance.now();
      if(now-capStep>=wait){
        capStep=now;
        capShown+=capTarget>capShown?1:-1;
        capPaint(capShown);
      }
    }
  }
  flDiscParallax(flScrollSmooth());
  ambStep(_y);
  if(prog){const w=(clamp(0,1,_y/GEO.max)*100).toFixed(1)+'%';
    if(w!==lastProg){lastProg=w;prog.style.width=w}}
  requestAnimationFrame(loop);
}
if(!REDUCED)requestAnimationFrame(loop);
else{caps.forEach(c=>c.classList.remove('show'));caps[0].classList.add('show');if(l)l.classList.add('done');}

/* ===== the environment's colour journey =================================
   Five keys down the document, three lights each. Between any two keys the
   channels are interpolated straight, so the room is never at a key except in
   passing — at almost every scroll position you are somewhere between two of
   them, which is what makes the change impossible to locate. Alphas stay
   between 6% and 9.5%: enough to feel, never enough to name.

   The progress is eased toward its target rather than taken raw, so a flung
   scroll does not drag the colour along with it at the same speed; the room
   arrives a moment after you do. */
const AMB=[
  /* Crystal blue and ice blue. Both were too saturated before — an electric
     blue and a cyan, which are lit colours rather than cold ones. Crystal and
     ice are pale and nearly grey; what they carry is temperature, not hue. */
  [0.00,[146,190,232,.219],[186,222,240,.201],[44,58,90,.178]],
  /* Midnight violet and deep indigo. The magenta that stood here was the one
     field on the page you could have named from across the room, and naming it
     is the failure. Indigo sits between violet and the hero's blue, so the
     discs are reached through the colour before them rather than against it.
     The electric blue stays, small, as a reflection thrown forward. */
  [0.28,[124,72,214,.256],[96,78,200,.236],[72,140,235,.169]],
  /* Smoky bronze, soft amber, warm graphite. Smoke means grey in it: the
     bronze is pulled well off full saturation so the warmth arrives as a
     change of temperature and not as a brown. */
  /* Electric blue faar staa alene et stykke foer bronsen tar over, saa reisen
     er violett -> blaatt -> varmt i stedet for violett rett i brunt. */
  [0.47,[58,134,255,.251],[96,150,240,.228],[72,120,200,.179]],
  /* Gullet holder fra 0.62 til 0.78 i stedet for aa snu med én gang. To
     noekler med samme farge gir en flat strekning mellom seg - fargen kommer
     fram, blir staaende gjennom hele bag-seksjonen, og forst deretter gaar
     den mot smaragd. Overgangen ut blir kortere og dermed tydeligere. */
  [0.62,[204,156,66,.240],[236,190,92,.220],[150,124,74,.196]],
  [0.78,[204,156,66,.240],[236,190,92,.220],[150,124,74,.196]],
  /* Deep emerald, dark teal, petrol. */
  [0.85,[34,150,104,.229],[28,112,124,.210],[36,96,116,.187]],
  /* Deep graphite and dark navy: the room it started in. */
  [1.00,[44,50,60,.210],[38,54,92,.197],[42,48,66,.174]]
];
let ambP=0, ambRoot=document.documentElement, ambLast='';
function ambMix(t){
  let i=0; while(i<AMB.length-2&&t>AMB[i+1][0]) i++;
  const A=AMB[i],B=AMB[i+1];
  let f=Math.max(0,Math.min(1,(t-A[0])/((B[0]-A[0])||1)));
  /* Eased at the ends only, linear through the middle — not smoothstep.
     Both remove the corner at a key, which is the thing you could see. But
     smoothstep pays for it by concentrating all the travel into the centre of
     the segment: it raised the fastest moment on the page from 5.9 to 8.0 dE
     across a screen of scrolling, so it fixed the corner by making the run
     between corners worse. This ramps the rate up over the first sixth,
     holds it flat, and lets it down over the last sixth. Rate is still zero
     at every key, and the peak is only 1.22x the flat run instead of 1.5x.

     The numbers that matter: no screen-height of scrolling anywhere on this
     page now moves the colour more than 2.3 dE, which is the threshold at
     which two colours side by side stop being distinguishable. It is not that
     the transitions are hard to see — there is no moment at which enough
     changes to be seen at all. Across the whole journey the zones still sit
     4 to 8 dE apart, and hero to bags is sixteen. Felt, never watched. */
  const W=.18;
  f = f<W      ? f*f/(2*W*(1-W))
    : f<1-W    ? (f-W/2)/(1-W)
    :            1-((1-f)*(1-f))/(2*W*(1-W));
  const out=[];
  for(let k=1;k<=3;k++){
    const a=A[k],b=B[k];
    const r=Math.round(a[0]+(b[0]-a[0])*f),g=Math.round(a[1]+(b[1]-a[1])*f),
          bl=Math.round(a[2]+(b[2]-a[2])*f),al=a[3]+(b[3]-a[3])*f;
    out.push('rgba('+r+','+g+','+bl+','+al.toFixed(3)+')',
             'rgba('+r+','+g+','+bl+','+(al*.37).toFixed(3)+')');
  }
  return out;
}
function ambStep(y){
  const lim=Math.max(1,document.documentElement.scrollHeight-innerHeight);
  const target=Math.max(0,Math.min(1,y/lim));
  ambP+=(target-ambP)*0.06;
  /* setProperty, never setAttribute('style') — the root carries inline state
     the smooth-scroll sets, and rewriting the whole attribute would drop it. */
  const c=ambMix(ambP), key=c[0]+c[2]+c[4];
  if(key!==ambLast){ambLast=key;
    for(let k=0;k<3;k++){
      ambRoot.style.setProperty('--amb'+(k+1),c[k*2]);
      ambRoot.style.setProperty('--amb'+(k+1)+'b',c[k*2+1]);
    }}
}
ambStep(scrollY); ambP=Math.max(0,Math.min(1,scrollY/Math.max(1,document.documentElement.scrollHeight-innerHeight)));

/* ===== reveal ===== */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('in')}),{threshold:.14});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

/* ===== catalog ===== */
