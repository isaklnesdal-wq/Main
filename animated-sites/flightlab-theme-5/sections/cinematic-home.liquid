const CLASS_ORDER=[['Putter','Puttere','Presisjon og kontroll rundt kurven'],['Approach','Approach','Trygge innspill mot kurven'],['Midrange','Midrange','Allrounderen i bagen'],['Fairway','Fairway-drivere','Kontrollert lengde'],['Distanse','Distansedrivere','Maks meter fra utkastet']];
function disc3(b,m,n){const s=BRAND[b],S=108;
  return '<div class="disc-scene"><div class="disc3d" style="width:'+S+'px;height:'+S+'px">'+
   '<div class="dl" style="background:radial-gradient(circle at 35% 30%,'+s.rim[0]+' 0%,'+s.rim[1]+' 45%,'+s.rim[2]+' 100%);box-shadow:inset 0 2px 5px rgba(255,255,255,.35),inset 0 -4px 8px rgba(0,0,0,.5),0 12px 20px rgba(4,8,14,.45)"></div>'+
   '<div class="dl dface" style="inset:7%;transform:translateZ(6px);background:repeating-radial-gradient(circle at 50% 50%,rgba(255,255,255,.035) 0 1.5px,rgba(0,0,0,.03) 1.5px 6px),radial-gradient(circle at 40% 35%,'+s.face[0]+' 0%,'+s.face[1]+' 60%,'+s.face[2]+' 100%)">'+
   '<div class="dring"></div>'+
   '<span style="font-size:6px;letter-spacing:2px;color:rgba(250,249,245,.75);text-transform:uppercase">'+b+'</span>'+
   '<span style="font-size:14px;color:#faf9f5;font-family:var(--h);font-style:italic;white-space:nowrap;margin-top:2px">'+m+'</span>'+
   '<span style="font-size:7px;letter-spacing:1px;color:rgba(250,249,245,.55);margin-top:3px">'+n.join(' · ')+'</span></div>'+
   '<div class="dl" style="transform:translateZ(7px);background:radial-gradient(ellipse 55% 35% at 30% 22%,rgba(255,255,255,.32),rgba(255,255,255,.06) 45%,transparent 65%)"></div>'+
   '</div></div>';}
/* Prices come from Shopify as window.FL_PRICE, keyed by product handle.
   The flat 179 kr is only a fallback for viewing this file on its own. */
const FLPRICE=(typeof window!=='undefined'&&window.FL_PRICE)||{};
const priceOf=d=>{const p=FLPRICE[d.h];return p&&isFinite(p.amount)?+p.amount:179};
const priceText=d=>{const p=FLPRICE[d.h];return p&&p.text?p.text:'179 kr'};

function card(d){return '<a class="pcard rv" href="/products/'+d.h+'"><div class="dw">'+disc3(d.b,d.m,d.n)+'</div><div class="shadow"></div>'+
  '<h3>'+d.b+' '+d.m+'</h3><span class="cls">'+d.c+'</span><span class="fn">'+d.n.join(' · ')+'</span>'+
  (d.p?'<span class="pw">'+d.p.join(' · ')+'<b>'+d.w[0]+'–'+d.w[1]+' g</b></span>':'')+
  '<span class="pr">'+priceText(d)+'</span></a>';}

/* ---- catalogue filter: brand, type, price ---- */
const F={brand:new Set(),type:new Set(),plast:new Set(),vekt:new Set(),sort:''};
/* Vektintervaller. En disc treffer et intervall dersom dens eget spenn
   overlapper det — ikke bare dersom det ligger helt innenfor. */
const VEKTBAND=[['Under 165 g','0-164'],['165–169 g','165-169'],['170–175 g','170-175'],['176 g og over','176-999']];
const groupsEl=document.getElementById('disc-groups');

function renderDiscs(first){
  let items=DISCS.filter(d=>
      (!F.brand.size||F.brand.has(d.b)) && (!F.type.size||F.type.has(d.c)) &&
      (!F.plast.size||(d.p||[]).some(x=>F.plast.has(x))) &&
      (!F.vekt.size||[...F.vekt].some(r=>{const b=r.split('-');
        return d.w && d.w[0]<=+b[1] && d.w[1]>=+b[0];})));
  if(F.sort){
    /* A price sort is global, so the per-class grouping is dropped while
       it is active — otherwise you would only be sorting within a class. */
    items=items.slice().sort((a,b)=>F.sort==='asc'?priceOf(a)-priceOf(b):priceOf(b)-priceOf(a));
    groupsEl.innerHTML=items.length?'<div class="disc-group"><div class="pgrid">'+items.map(card).join('')+'</div></div>':'';
  }else{
    groupsEl.innerHTML=CLASS_ORDER.map(([key,title,sub])=>{
      const g=items.filter(d=>d.c===key);if(!g.length)return '';
      return '<div class="disc-group"><div class="gt rv"><h3>'+title+'</h3><span>'+sub+' · '+g.length+' modeller</span></div>'+
        '<div class="pgrid">'+g.map(card).join('')+'</div></div>';
    }).join('');
  }
  const empty=document.getElementById('fempty');if(empty)empty.hidden=items.length>0;
  const n=F.brand.size+F.type.size+F.plast.size+F.vekt.size+(F.sort?1:0);
  const c=document.getElementById('fcount');if(c){c.hidden=!n;c.textContent=n||''}
  const res=document.getElementById('fres');
  if(res)res.textContent=items.length===DISCS.length?'Viser alle '+DISCS.length+' discer'
    :items.length+' av '+DISCS.length+' discer';
  /* First paint keeps the scroll reveal; later re-renders show at once, so
     filtering does not look like a blank grid. */
  if(first)groupsEl.querySelectorAll('.rv').forEach(el=>io.observe(el));
  else groupsEl.querySelectorAll('.rv').forEach(el=>el.classList.add('in'));
}

(function(){
  const btn=document.getElementById('filterbtn'),panel=document.getElementById('filterpanel');
  if(!btn||!panel){renderDiscs(true);return}
  const chip=(label,v)=>'<button class="fchip" type="button" role="switch" aria-pressed="false" data-v="'+v+'">'+label+'</button>';
  const brands=[...new Set(DISCS.map(d=>d.b))].sort((a,b)=>a.localeCompare(b,'no'));
  document.getElementById('fbrand').innerHTML=brands.map(b=>chip(b,b)).join('');
  document.getElementById('ftype').innerHTML=CLASS_ORDER
    .filter(([k])=>DISCS.some(d=>d.c===k)).map(([k,title])=>chip(title,k)).join('');
  const plaster=[...new Set(DISCS.flatMap(d=>d.p||[]))].sort((a,b)=>a.localeCompare(b,'no'));
  document.getElementById('fplast').innerHTML=plaster.map(x=>chip(x,x)).join('');
  document.getElementById('fvekt').innerHTML=VEKTBAND.map(([t,v])=>chip(t,v)).join('');
  document.getElementById('fprice').innerHTML=chip('Lav til høy','asc')+chip('Høy til lav','desc');

  btn.addEventListener('click',()=>{
    const open=btn.getAttribute('aria-expanded')==='true';
    btn.setAttribute('aria-expanded',String(!open));panel.hidden=open;
  });
  panel.addEventListener('click',e=>{
    const t=e.target.closest('.fchip');
    if(t){
      const v=t.dataset.v,grp=t.parentElement.id;
      if(grp==='fprice'){                       // price is a single choice
        const on=F.sort===v;F.sort=on?'':v;
        [...t.parentElement.children].forEach(c=>c.setAttribute('aria-pressed',String(!on&&c===t)));
      }else{
        const set=grp==='fbrand'?F.brand:grp==='fplast'?F.plast:grp==='fvekt'?F.vekt:F.type;
        if(set.has(v)){set.delete(v);t.setAttribute('aria-pressed','false')}
        else{set.add(v);t.setAttribute('aria-pressed','true')}
      }
      renderDiscs(false);return;
    }
    if(e.target.closest('#fclear'))clearAll();
  });
  document.addEventListener('click',e=>{if(e.target.closest('[data-clear]'))clearAll()});
  function clearAll(){
    F.brand.clear();F.type.clear();F.plast.clear();F.vekt.clear();F.sort='';
    panel.querySelectorAll('.fchip').forEach(c=>c.setAttribute('aria-pressed','false'));
    renderDiscs(false);
  }
  renderDiscs(true);
})();

// bags (dedicated section)
const BAGS=[
