  {img:'https://images.pexels.com/photos/6311392/pexels-photo-6311392.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Øvingskurv',d:'Bærbar kurv for putt-trening hjemme',p:'899 kr',h:'ovingskurv'}
];
/* Image source, in priority order:
   1. window.FL_IMG[handle] — set by Shopify (theme setting, else product photo)
   2. the built-in placeholder below
   Lets the shop owner swap any card image from Theme settings without code. */
const FLIMG=(typeof window!=='undefined'&&window.FL_IMG)||{};
const imgFor=a=>FLIMG[a.h]||a.img;
const acard=a=>'<a class="acard rv" href="/products/'+a.h+'"><div class="im"><img src="'+imgFor(a)+'" alt="'+a.n+'" loading="lazy" onerror="this.style.display=\'none\'"></div>'+
  '<div class="bd"><h4>'+a.n+'</h4><div class="ad">'+a.d+'</div><div class="ap">'+a.p+'</div></div></a>';
if(window.FL_HERO){const hd=document.getElementById('herodisc');if(hd)hd.src=window.FL_HERO;}
document.getElementById('bgrid').innerHTML=BAGS.map(acard).join('');
document.getElementById('agrid').innerHTML=ACC.map(acard).join('');
document.querySelectorAll('#disc-groups .rv,#bgrid .rv,#agrid .rv').forEach(el=>io.observe(el));

document.getElementById('nlform').addEventListener('submit',e=>{e.preventDefault();
  const f=e.target;if(f.querySelector('input').value.trim()){f.outerHTML='<div class="nlthanks">Takk! Vi sier ifra så fort dørene åpner. 🥏</div>'}});

/* ===== catalogue search: live filter here, full-store search on submit ===== */
(function(){
  const q=document.getElementById('q'),hint=document.getElementById('searchhint');
  if(!q)return;
  const secs=['discer','bager','tilbehor'].map(id=>document.getElementById(id)).filter(Boolean);
  const bp=document.getElementById('bagcap');
  function run(){
    const term=q.value.trim().toLowerCase();
    const cards=document.querySelectorAll('#disc-groups .pcard,#bgrid .acard,#agrid .acard');
    let shown=0;
    cards.forEach(c=>{const hit=!term||c.textContent.toLowerCase().includes(term);c.style.display=hit?'':'none';if(hit&&term)shown++;});
    document.querySelectorAll('#disc-groups .disc-group').forEach(g=>{
      g.style.display=[...g.querySelectorAll('.pcard')].some(c=>c.style.display!=='none')?'':'none';});
    if(term){
      secs.forEach(s=>{const any=[...s.querySelectorAll('.pcard,.acard')].some(c=>c.style.display!=='none');s.style.display=any?'':'none';});
      if(bp)bp.style.display='none';
      hint.className='searchhint on';
      hint.innerHTML=shown+' treff · <a href="#discer">Vis ↓</a> · <a href="/search?q='+encodeURIComponent(q.value)+'">Hele butikken →</a>';
    }else{
      secs.forEach(s=>s.style.display='');if(bp)bp.style.display='';hint.className='searchhint';hint.innerHTML='';
    }
  }
  q.addEventListener('input',run);
})();

/* ===== Apple-style press feedback (pointer-based so iOS Safari honours it) ===== */
(function(){
  const SEL='.pcard,.acard,.btn,nav .nl a,.brand,.filterbtn,.fchip';
  addEventListener('pointerdown',e=>{const t=e.target.closest(SEL);if(t)t.classList.add('pressing');},{passive:true});
  const clear=()=>document.querySelectorAll('.pressing').forEach(el=>el.classList.remove('pressing'));
  ['pointerup','pointercancel','pointerleave','dragstart','scroll'].forEach(ev=>addEventListener(ev,clear,{passive:true}));
})();
</script>

