{%- comment -%} Category Experience (Homepage Blueprint §9, Design Bible §14) {%- endcomment -%}
<section class="section category-explorer">
  <div class="page-width">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="text-display">{{ section.settings.heading }}</h2>
    </div>

    <div class="category-grid">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        <a href="{{ col.url | default: '#' }}" class="category-card" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms;" {{ block.shopify_attributes }}>
          <div class="category-card__media">
            {%- assign img = block.settings.image | default: col.featured_image -%}
            {%- if img != blank -%}
              {{ img
                | image_url: width: 1100
                | image_tag:
                  widths: '420, 640, 860, 1100',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.title | default: col.title }}
            {%- endif -%}
          </div>
          <div class="category-card__body">
            <h3 class="category-card__title">{{ block.settings.title | default: col.title }}</h3>
            <p class="category-card__tagline">{{ block.settings.tagline }}</p>
            <span class="link-arrow">
              Utforsk
              {% render 'icon', name: 'arrow-right', size: 16 %}
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategorier",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Kategorier" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Bygg baggen din" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategori",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Tittel (overstyrer collection-navn)" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "Kontroll. Presisjon." },
        { "type": "image_picker", "id": "image", "label": "Bilde (overstyrer collection-bilde)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategorier",
      "blocks": [
        { "type": "category", "settings": { "title": "Putters", "tagline": "Det siste kastet avgjør." } },
        { "type": "category", "settings": { "title": "Midrange", "tagline": "Kontroll og presisjon." } },
        { "type": "category", "settings": { "title": "Drivers", "tagline": "Lengde når det gjelder." } },
        { "type": "category", "settings": { "title": "Startsett", "tagline": "Alt du trenger for å begynne." } }
      ]
    }
  ]
}
{% endschema %}
