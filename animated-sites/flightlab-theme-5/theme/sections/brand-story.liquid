{%- comment -%} Brand Story (Homepage Blueprint §7) {%- endcomment -%}
<section class="section brand-story">
  <div class="page-width">
    <div class="brand-story__grid">
      <div class="brand-story__media" data-reveal>
        {%- if section.settings.image != blank -%}
          {{ section.settings.image
            | image_url: width: 1200
            | image_tag:
              widths: '540, 760, 1000, 1200',
              sizes: '(min-width: 990px) 45vw, 100vw',
              loading: 'lazy',
              alt: section.settings.image.alt | default: section.settings.heading }}
        {%- endif -%}
      </div>
      <div data-reveal style="--reveal-delay: 120ms;">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="text-display">{{ section.settings.heading }}</h2>
        <div class="lead">{{ section.settings.text }}</div>
        {%- if section.settings.cta_label != blank -%}
          <p style="margin-top: var(--space-5);">
            <a href="{{ section.settings.cta_link }}" class="link-arrow">
              {{ section.settings.cta_label }}
              {% render 'icon', name: 'arrow-right', size: 18 %}
            </a>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Merkevarehistorie",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bilde" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Hvorfor Flightlab" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Skapt for sporten. Bygget for naturen." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Discgolf er mer enn et spill. Det er skogsluft, konsentrasjon og følelsen når discen forlater hånden på akkurat riktig måte. Flightlab finnes for å gi deg utstyret som gjør de øyeblikkene flere — enten du kaster din første runde eller jakter på personlig rekord.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "Lenketekst", "default": "Les historien vår" },
    { "type": "url", "id": "cta_link", "label": "Lenke" }
  ],
  "presets": [{ "name": "Merkevarehistorie" }]
}
{% endschema %}
