<div class="cart-drawer" id="CartDrawer" aria-hidden="true">
  <div class="cart-drawer__backdrop"></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Handlekurv">
    <div class="cart-drawer__head">
      <h2>Handlekurv{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</h2>
      <button class="header-icon-btn" type="button" data-drawer-close aria-label="Lukk handlekurv">
        {% render 'icon', name: 'close', size: 22 %}
      </button>
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__items">
        {%- for item in cart.items -%}
          <div class="cart-line">
            <div class="cart-line__media">
              {%- if item.image -%}
                {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.title }}
              {%- endif -%}
            </div>
            <div>
              <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
              <div class="cart-line__meta">
                {{ item.vendor }}
                {%- unless item.variant.title == 'Default Title' %} · {{ item.variant.title }}{% endunless -%}
              </div>
              <div class="cart-line__row">
                <span class="qty">
                  <button type="button" data-cart-change data-key="{{ item.key }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="Reduser antall">−</button>
                  <input type="text" value="{{ item.quantity }}" readonly aria-label="Antall">
                  <button type="button" data-cart-change data-key="{{ item.key }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="Øk antall">+</button>
                </span>
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
              <button class="cart-line__remove" type="button" data-cart-change data-key="{{ item.key }}" data-quantity="0">Fjern</button>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-drawer__foot">
        <p class="cart-drawer__shipping">
          {{ settings.shipping_note }} · {{ settings.delivery_note }}
        </p>
        <div class="cart-drawer__subtotal">
          <span>Delsum</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <a href="{{ routes.cart_url }}/checkout" class="btn btn--primary">Til kassen</a>
      </div>
    {%- else -%}
      <div class="cart-drawer__empty">
        {% render 'icon', name: 'disc', size: 44 %}
        <p>Handlekurven er tom.<br>På tide å finne din neste favorittdisc.</p>
        <a href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" class="btn btn--dark" data-drawer-close>Utforsk discer</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Handlekurv-skuff",
  "settings": [
    { "type": "url", "id": "empty_link", "label": "Lenke ved tom handlekurv" }
  ]
}
{% endschema %}
