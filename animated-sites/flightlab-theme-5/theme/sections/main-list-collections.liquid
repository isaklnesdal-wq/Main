<div class="page-width" style="padding-block: var(--space-6) var(--space-8);">
  <div class="section-head">
    <span class="eyebrow">Kategorier</span>
    <h1 class="text-display">Utforsk sortimentet</h1>
  </div>

  <div class="category-grid">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a href="{{ collection.url }}" class="category-card">
          <div class="category-card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title }}
            {%- endif -%}
          </div>
          <div class="category-card__body">
            <h2 class="category-card__title">{{ collection.title }}</h2>
            <span class="link-arrow">Utforsk {% render 'icon', name: 'arrow-right', size: 16 %}</span>
          </div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Alle kategorier",
  "settings": []
}
{% endschema %}
