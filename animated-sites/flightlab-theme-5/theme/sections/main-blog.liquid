<div class="page-width" style="padding-block: var(--space-6) var(--space-8);">
  <div class="section-head">
    <span class="eyebrow">Guider</span>
    <h1 class="text-display">{{ blog.title }}</h1>
  </div>

  {%- paginate blog.articles by 12 -%}
    <div class="article-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card">
          <div class="article-card__media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}
            {%- endif -%}
          </div>
          <h2 class="article-card__title">{{ article.title }}</h2>
          <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
        </a>
      {%- else -%}
        <p class="lead">Guidene er på vei. Her kommer alt du trenger å vite — fra første kast til avansert teknikk.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Sider">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span aria-current="page">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blogg",
  "settings": []
}
{% endschema %}
