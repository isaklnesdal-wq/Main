<style>
.chead h1{font-weight:600;font-size:clamp(26px,4vw,40px);letter-spacing:-.02em}
.chead p{color:var(--mut);font-weight:300;margin-top:8px;max-width:60ch}
.cgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:30px}
@media(max-width:1000px){.cgrid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.cgrid{grid-template-columns:1fr}}
.pc{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;transition:transform .25s,box-shadow .25s;display:flex;flex-direction:column}
.pc:hover{transform:translateY(-5px);box-shadow:0 16px 36px rgba(14,26,19,.12)}
.pc .im{aspect-ratio:1;background:linear-gradient(140deg,#1B4332,#0E1A13);display:flex;align-items:center;justify-content:center}
.pc .im img{width:100%;height:100%;object-fit:cover}
.pc .im span{font-family:var(--h);font-size:11px;letter-spacing:.18em;color:rgba(250,249,245,.45);text-transform:uppercase}
.pc .bd{padding:14px 16px 18px}
.pc h3{font-weight:600;font-size:15px}
.pc .v{font-size:11px;color:var(--mut);margin-top:3px}
.pc .pr{margin-top:8px;font-family:var(--h);font-weight:600;color:var(--forest)}
.pag{margin-top:34px;display:flex;gap:14px;justify-content:center;font-size:14px}
</style>
<div class="chead"><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<p>{{ collection.description | strip_html }}</p>{% endif %}</div>
{% paginate collection.products by 24 %}
<div class="cgrid">
  {% for product in collection.products %}
  <a class="pc" href="{{ product.url }}">
    <div class="im">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}">{% else %}<span>Flightlab</span>{% endif %}</div>
    <div class="bd"><h3>{{ product.title }}</h3><div class="v">{{ product.vendor }}</div><div class="pr">{{ product.price | money }}</div></div>
  </a>
  {% endfor %}
</div>
<div class="pag">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Forrige</a>{% endif %}{% if paginate.next %}<a href="{{ paginate.next.url }}">Neste →</a>{% endif %}</div>
{% endpaginate %}
