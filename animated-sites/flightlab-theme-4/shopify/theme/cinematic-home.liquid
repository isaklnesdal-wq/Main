}
function drawChips(q,scale,cx,cy){
  const g=flshards.getContext('2d');
  const W=flshards.width, H=flshards.height, dpr=chipScale;
  g.clearRect(0,0,W,H);
  if(!CHIPS||q<=0) return;
  /* Four alpha buckets, one path each: batching keeps this to four fills a
     frame instead of one per chip. */
  const B=4, paths=[];
  for(let i=0;i<B;i++) paths.push(new Path2D());
  const drift=innerWidth*0.30;
  for(let i=0;i<CHIPS.length;i++){
    const c=CHIPS[i];
    const t=(q-c.rel)/(1-c.rel);
    if(t<=0) continue;
    const e=t*t*t;                                /* barely moves, then leaves */
    const px=c.x*scale+c.vx*drift*e+cx;
    const py=c.y*scale+c.vy*drift*e+cy;
    if(px<-40||py<-40||px>W/dpr+40||py>H/dpr+40) continue;
    const gw=c.w*scale*(1+e*0.5), gh=c.h*scale*(1+e*0.5);
    const a=c.al*(1-t);
    if(a<=0.02) continue;
    const b=Math.min(B-1,(a*B)|0);
    paths[b].rect(px*dpr,py*dpr,gw*dpr,gh*dpr);
  }
  for(let i=0;i<B;i++){
    g.fillStyle='rgba(216,246,255,'+(((i+0.5)/B)*0.9).toFixed(3)+')';
    g.fill(paths[i]);
  }
}
/* ---- Floating system ----
   Discs are laid out down the whole document, then each layer is offset against
   the scroll by its own factor. A disc at document position T shows up on screen
   at T - k*scrollY, so a layer needs to cover vh + k*(doc - vh); spacing them
   over exactly that range is what keeps discs entering and leaving continuously
   instead of resetting anywhere. */
const flLayers=[...document.querySelectorAll('.fl-layer')].map(el=>({
  el, k:parseFloat(el.dataset.k), n:parseInt(el.dataset.n,10), l:el.dataset.l}));
const FL_SIZE={l1:[40,64],l2:[14,26],l3:[4.5,8]};
function flBuildDiscs(){
  const coarse=matchMedia('(hover:none)').matches;
  const doc=document.documentElement.scrollHeight, vh=innerHeight;
  flLayers.forEach((L,li)=>{
    const n=coarse?Math.max(2,L.n-2):L.n;
    const span=vh+L.k*Math.max(0,doc-vh);
    const [smin,smax]=FL_SIZE[L.l];
    let html='';
    for(let i=0;i<n;i++){
      /* Deterministic jitter: same layout every load, no clumping. */
      const r1=((i*2654435761)%1000)/1000, r2=((i*40503+li*7919)%1000)/1000;
      const top=span*((i+0.5)/n)-vh*0.2+ (r1-0.5)*span/n*0.30;
      const left=6+r2*82;
      const d=smin+(smax-smin)*r1;
      const dur=[240,300,270,195,170,182][i%6]+li*40;
      const name=['fl8-far','fl8-mid','fl8-near'][li];
      html+='<span class="fl-disc '+L.l+'" style="--d:'+d.toFixed(1)+'vmin;left:'+left.toFixed(1)
           +'%;top:'+top.toFixed(0)+'px;animation:'+name+' '+dur+'s ease-in-out infinite'
           +(i%2?' reverse':'')+'"></span>';
    }
    L.el.innerHTML=html;
  });
}
function flDiscParallax(y){
  for(let i=0;i<flLayers.length;i++){
    const L=flLayers[i];
    L.el.style.transform='translate3d(0,'+(-y*L.k).toFixed(1)+'px,0)';
  }
}
function sizeShards(){
  if(!flshards) return;
  const r=flshards.getBoundingClientRect();
  /* A phone rasterises at 3x; the chips are small, soft and moving, so
     drawing them at 1:1 is invisible and cuts the fill area ninefold. */
  chipScale=matchMedia('(hover:none)').matches?1:Math.min(2,devicePixelRatio||1);
  flshards.width=Math.round(r.width*chipScale);
  flshards.height=Math.round(r.height*chipScale);
}
/* Fit the wordmark to 70% of the viewport. Inter arrives over the network, so
   its metrics are not known at author time and a hard-coded font-size would
   land wherever the fallback happened to be wide. Measure once the font is in,
   and again after a resize. getBBox is a layout read, so this runs off the
   scroll path entirely. */
const flsvg=document.getElementById('flsvg');
function flFit(){
  if(!flsvg) return;
  const t=flsvg.querySelector('.g-body');
  t.style.fontSize='';                       /* back to the CSS value to measure */
  let w=0; try{w=t.getBBox().width}catch(e){return}
  if(!w) return;
  const cur=parseFloat(getComputedStyle(t).fontSize);
  const px=cur*(innerWidth*0.70)/w;
  flsvg.querySelectorAll('text').forEach(n=>n.style.fontSize=px+'px');
}
if(document.fonts&&document.fonts.ready){document.fonts.ready.then(flFit)}else{flFit()}
flFit();
addEventListener('resize',(()=>{let t;return()=>{clearTimeout(t);t=setTimeout(()=>{flFit();sizeShards();buildChips();flBuildDiscs();flDiscParallax(scrollY)},150)}})());
