/* Backdrop: a hazy forest fairway with a low sun and a disc-golf basket
   standing under the disc. Built once as static SVG — it is never
   transformed while scrolling, so the whole scene costs a single paint.
   The realism comes from atmospheric perspective rather than detail:
   distant layers are pale and low-contrast, near layers darker and
   coarser, with mist banding between them. */
(function(){
  const sc=document.getElementById('scape');if(!sc)return;
  const W=1440,H=620;
  let seed=23;const rnd=()=>(seed=(seed*16807)%2147483647)/2147483647;
  const R=(a,b)=>a+rnd()*(b-a);
  /* whole viewBox units: the scape renders at roughly 0.9 px per unit, so
     sub-pixel precision only inflates the markup */
  const f=n=>n.toFixed(0);

  /* A spruce built from tiered, drooping branches with per-tier jitter,
     so the silhouette breaks up the way a real conifer does instead of
     reading as the plain triangle this used to draw. */
  function spruce(x,base,h,w,lean){
    const tiers=Math.round(R(9,14)),top=base-h;
    let right='',left='';
    for(let i=1;i<=tiers;i++){
      const t=i/tiers;
      const y=top+h*Math.pow(t,0.94);
      const hw=w*Math.pow(t,0.8)*R(0.84,1.14);
      const cx=x+lean*Math.pow(1-t,2)*h*0.1;
      const droop=h*0.024*R(0.5,1.4);
      const notch=R(0.42,0.62),step=h*0.042;
      right+=' L'+f(cx+hw)+' '+f(y+droop)+' L'+f(cx+hw*notch)+' '+f(y+step);
      left=' L'+f(cx-hw*notch)+' '+f(y+step)+' L'+f(cx-hw)+' '+f(y+droop)+left;
    }
    const tw=Math.max(1.2,w*0.1);
    return 'M'+f(x)+' '+f(top)+right+' L'+f(x+tw)+' '+f(base)+' L'+f(x-tw)+' '+f(base)+left+' Z';
  }

  /* A broadleaf — lumpy canopy on a short trunk, mixed in for variety so
     the treeline isn't uniformly coniferous. */
  function broadleaf(x,base,h,w){
    const n=11,cy=base-h*0.6,rx=w*0.5,ry=h*0.44,pts=[];
    for(let i=0;i<n;i++){
      const a=Math.PI*2*i/n,k=R(0.9,1.09);
      pts.push([x+Math.cos(a)*rx*k,cy+Math.sin(a)*ry*k]);
    }
    /* round each span outwards into a lobe, so the canopy reads as foliage
       instead of the angular boulder a straight-edged polygon gives */
    let d='M'+f(pts[0][0])+' '+f(pts[0][1]);
    for(let i=1;i<=n;i++){
      const p=pts[i%n],q=pts[i-1];
      const mx=(q[0]+p[0])*0.5,my=(q[1]+p[1])*0.5;
      d+=' Q'+f(x+(mx-x)*1.3)+' '+f(cy+(my-cy)*1.3)+' '+f(p[0])+' '+f(p[1]);
    }
    const tw=Math.max(1.4,w*0.045),ty=cy+ry*0.55;
    return d+' Z M'+f(x-tw)+' '+f(base)+' L'+f(x-tw*0.5)+' '+f(ty)+
      ' L'+f(x+tw*0.5)+' '+f(ty)+' L'+f(x+tw)+' '+f(base)+' Z';
  }

  /* One band of forest. Trees are split across three sub-paths drawn at
