    '<linearGradient id="gPole" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#22382a"/><stop offset=".42" stop-color="#54705b"/><stop offset="1" stop-color="#1b2f22"/></linearGradient>'+
    '<linearGradient id="gCage" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#294331"/><stop offset=".46" stop-color="#3f6048"/><stop offset="1" stop-color="#1f3527"/></linearGradient>'+
    '<linearGradient id="gMist" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#f4faf6" stop-opacity=".8"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>'+
    '</defs>';

  sc.innerHTML='<svg viewBox="0 0 '+W+' '+H+'" preserveAspectRatio="xMidYMax slice">'+defs+
