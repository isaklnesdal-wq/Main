    '<path d="M0 444 Q360 432 720 440 Q1080 448 1440 436 L'+W+' '+H+' L0 '+H+' Z" fill="url(#gGround)"/>'+
    '<ellipse cx="700" cy="470" rx="520" ry="26" fill="#b3d191" opacity=".3"/>'+
