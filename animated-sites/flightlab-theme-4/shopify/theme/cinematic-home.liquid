   A realistic moulded frisbee floats level in the hero, glowing and rocking
   gently. Scrolling levels it out to face you and flies you THROUGH its
   pressed rings (eased scale — slow approach, deep dive) before the bloom
   hands off to the catalogue. A second portal later zooms INTO an
   illustrated disc-golf bag before the bags grid. Only transform and
   opacity are animated — composited on the GPU, no repaint. */
const journey=document.getElementById('journey');
const flmark=document.getElementById('flmark');
/* ---- Dissolve ------------------------------------------------------------
   The wordmark is rasterised once, at idle, into a small offscreen canvas. Every
   opaque sample on a grid becomes a chip, and each chip records how far it sat
   from the edge of its letter — that distance becomes its release time, so the
   edges let go first and the interiors last, the way a solid actually comes
   apart. Nothing here runs on the scroll path except the draw. */
const flshards=document.getElementById('flshards');
let CHIPS=null, chipScale=1;
function buildChips(){
  if(!flsvg||!flshards) return;
  const t=flsvg.querySelector('.g-body');
  let bb; try{bb=t.getBBox()}catch(e){return}
  if(!bb.width) return;
  const cs=getComputedStyle(t);
  const RW=420, k=RW/bb.width, RH=Math.max(8,Math.round(bb.height*k))+8;
  const c=document.createElement('canvas'); c.width=RW; c.height=RH;
  const x=c.getContext('2d',{willReadFrequently:true});
  x.font=cs.fontWeight+' '+(parseFloat(cs.fontSize)*k)+'px '+cs.fontFamily;
  if('letterSpacing' in x) x.letterSpacing=(parseFloat(cs.fontSize)*k*-0.045)+'px';
  x.textAlign='center'; x.textBaseline='middle'; x.fillStyle='#fff';
  x.fillText('FLIGHTLAB',RW/2,RH/2);
  const px=x.getImageData(0,0,RW,RH).data;
  const on=(ix,iy)=>ix>=0&&iy>=0&&ix<RW&&iy<RH&&px[((iy*RW+ix)<<2)+3]>110;
  const coarse=matchMedia('(hover:none)').matches;
  const out=[], STEP=coarse?4:2, MAXR=9;
  for(let iy=0;iy<RH;iy+=STEP) for(let ix=0;ix<RW;ix+=STEP){
    if(!on(ix,iy)) continue;
    let d=MAXR;
    for(let r=1;r<MAXR;r++){
      if(!on(ix+r,iy)||!on(ix-r,iy)||!on(ix,iy+r)||!on(ix,iy-r)){d=r;break}
    }
    /* Jitter off the sampling lattice. Without this the chips line up in rows
       and columns, and the camera magnifies that grid along with everything
       else. The offset is in word space so it scales with the chip. */
    const jx=(Math.random()-.5)*STEP*1.6, jy=(Math.random()-.5)*STEP*1.6;
    const nx=(ix-RW/2+jx)/k, ny=(iy-RH/2+jy)/k;  /* back into word pixels */
    const a=Math.atan2(ny,nx)+(Math.random()-.5)*1.1;
    const sz=0.26+Math.random()*0.48;
    out.push({x:nx,y:ny,
      rel:Math.min(1,(d-1)/(MAXR-1))*0.72,       /* edges released first */
      vx:Math.cos(a)*(0.22+Math.random()*0.62),
      vy:Math.sin(a)*(0.22+Math.random()*0.62)-0.08,
      w:sz*(0.6+Math.random()*1.5),              /* chips, not squares */
      h:sz*(0.6+Math.random()*1.5),
      al:0.40+Math.random()*0.60});
