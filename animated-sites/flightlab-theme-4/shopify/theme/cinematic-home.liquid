      '<ellipse cx="-16" cy="5" rx="66" ry="11" fill="#2c5133" opacity=".32"/>'+
      '<rect x="-5" y="-176" width="10" height="170" rx="3" fill="url(#gPole)"/>'+
      '<path d="M-58 -58 L-45 -16 A45 7 0 0 0 45 -16 L58 -58 Z" fill="url(#gCage)"/>'+
      '<g fill="none">'+slats+'</g>'+
      '<ellipse cx="0" cy="-16" rx="45" ry="7" fill="none" stroke="#1d3325" stroke-width="2.4"/>'+
      '<ellipse cx="0" cy="-58" rx="58" ry="9" fill="none" stroke="#2c4835" stroke-width="5"/>'+
      '<ellipse cx="0" cy="-59.5" rx="58" ry="9" fill="none" stroke="#c3d6c6" stroke-width="1.5" opacity=".65"/>'+
      chains+
      '<ellipse cx="0" cy="-168" rx="52" ry="8" fill="none" stroke="#2c4835" stroke-width="4.5"/>'+
      '<ellipse cx="0" cy="-169.5" rx="52" ry="8" fill="none" stroke="#c3d6c6" stroke-width="1.4" opacity=".6"/>'+
