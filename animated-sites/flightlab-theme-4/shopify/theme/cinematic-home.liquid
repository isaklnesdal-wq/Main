    '<linearGradient id="gFar" x1="0" y1="0" x2=".3" y2="1"><stop offset="0" stop-color="#cadfd1"/><stop offset="1" stop-color="#a9c7b8"/></linearGradient>'+
    '<linearGradient id="gMid" x1="0" y1="0" x2=".3" y2="1"><stop offset="0" stop-color="#93b797"/><stop offset="1" stop-color="#628a6e"/></linearGradient>'+
    '<linearGradient id="gNear" x1="0" y1="0" x2=".3" y2="1"><stop offset="0" stop-color="#578266"/><stop offset="1" stop-color="#32543e"/></linearGradient>'+
    '<linearGradient id="gFore" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2e4b37"/><stop offset="1" stop-color="#1b3123"/></linearGradient>'+
