     only three paths per band, so it stays cheap. */
  function band(baseY,hMin,hMax,wRatio,count,broadChance){
    const tone=['','',''];
    for(let i=0;i<count;i++){
      /* clustered rather than evenly spaced — real treelines clump */
      const x=-50+(W+100)*(i+R(-0.55,0.55))/count;
      const h=R(hMin,hMax)*(rnd()<0.22?R(1.15,1.4):1);   // occasional tall one
      const b=baseY+R(-5,5);
      const t=rnd()<0.5?0:(rnd()<0.5?1:2);
      tone[t]+=(broadChance&&rnd()<broadChance)
        ? broadleaf(x,b,h*0.74,h*wRatio*1.7)
        : spruce(x,b,h,h*wRatio,R(-1,1));
