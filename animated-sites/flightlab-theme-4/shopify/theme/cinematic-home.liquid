<script>
'use strict';
const REDUCED=matchMedia('(prefers-reduced-motion: reduce)').matches;
const TOUCH=matchMedia('(pointer:coarse)').matches;

/* On mobile, transforming a filtered SVG re-rasterises the whole filter
   region every scroll frame — the #1 cause of the bag-zoom jank. Strip the
   turbulence/blur filters on touch so the bag is flat vector = composited,
   no per-frame re-raster. Desktop keeps the full texture + soft shadows. */
if(TOUCH){
  document.querySelectorAll('#bagbig [filter]').forEach(el=>el.removeAttribute('filter'));
}

/* ---- smooth momentum scroll ---- */
let lenis=null;
if(window.Lenis && !REDUCED && !matchMedia('(pointer:coarse)').matches){
  document.documentElement.style.scrollBehavior='auto';
  lenis=new Lenis({duration:1.25,easing:t=>Math.min(1,1.001-Math.pow(2,-10*t)),smoothWheel:true,touchMultiplier:1.6});
  (function raf(t){lenis.raf(t);requestAnimationFrame(raf)})();
  document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{
    const id=a.getAttribute('href');if(id&&id.length>1&&document.querySelector(id)){e.preventDefault();lenis.scrollTo(id,{duration:1.4})}}));
}

