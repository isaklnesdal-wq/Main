/* Rasterising the bag SVG is the heaviest thing on this page, and the cost
   grows with how far it is scaled up — vector art is re-rastered at each
   new scale, unlike the hero photo. Cap the zoom lower on phones. */
const ZBAG=TOUCH?5.5:9.9, ZHERO=TOUCH?7:11;
let lastKey='';
function loop(){
  // Only touch the hero when its section is actually on screen — avoids
  // writing transforms every frame while the user is down in the catalogue.
  const jr=journey.getBoundingClientRect();
  if(jr.bottom>0 && jr.top<innerHeight){
    const pRaw=clamp(0,1,-jr.top/(jr.height-innerHeight));
    /* HOLD. For the first stretch after load the piece simply sits there and
       nothing responds to the wheel — long enough to look at the material
       before touching anything. Afterwards the shown position eases toward the
       real scroll position rather than snapping to it, so however far someone
       scrolled during the hold, the camera still starts from rest and arrives
       without a step. */
    if(!flArmed) pShown=0;
    else pShown += (pRaw-pShown)*0.075;
    const p=pShown;
    const e=smooth(p);
    /* Dolly, not scale. We pick the apparent size we want, then solve for the
       camera distance that produces it, so the growth carries real
       perspective and the type stays type. */
    const s=1+Math.pow(e,1.45)*ZHERO;
    const z=PERSP*(1-1/s);
    /* A flat plane under a perspective transform projects to a plain uniform
       scale — mathematically it cannot look like anything else, which is why
       the pure dolly still read as zooming. Giving the word a small yaw as the
       camera closes puts its two ends at different depths, so the near end
       grows faster than the far end. That difference is parallax, and parallax
       is the thing the eye reads as travelling rather than scaling. Both start
       at zero, so the piece is perfectly frontal while it is being looked at. */
    /* The yaw is a desktop-only cue. A 3D-rotated element takes a different
       raster path, which measured as the dominant new cost on a phone, and at
       phone size the parallax it buys spans a few pixels. Touch keeps the pure
       dolly. */
    const yaw=TOUCH?0:(6.4*e);
    const dx=(TOUCH?0:-3.1*e*innerWidth/100);
    if(flmark){
      const moving=p>0.006;
      if(moving!==flMoving){flMoving=moving;flmark.classList.toggle('fl-moving',moving)}
      flmark.style.transform=TOUCH
        ? 'translate3d(0,0,'+z.toFixed(2)+'px)'
        : 'translate3d('+dx.toFixed(1)+'px,0,'+z.toFixed(2)+'px) rotateY('+yaw.toFixed(2)+'deg)';
      /* The word hands over to the chips rather than simply fading: it clears
         while the field is still dense, so what you watch leave is crystal. */
      const q=smooth(clamp(0,1,(p-0.44)/0.52));
      flmark.style.opacity=(1-smooth(clamp(0,1,(p-0.42)/0.32))).toFixed(3);
      if(flshards){
        if(q>0){
          if(flshards.style.opacity!=='1') flshards.style.opacity='1';
          drawChips(q,s,flshards.width/chipScale/2+dx,flshards.height/chipScale/2);
        }else if(flshards.style.opacity!=='0'){
          flshards.style.opacity='0';
          drawChips(0,s,0,0);
        }
      }
    }
    const key=p.toFixed(3);
    if(key!==lastKey){lastKey=key;
      caps.forEach(c=>{const s=+c.dataset.show,h=+c.dataset.hide;c.classList.toggle('show',p>=s&&p<h)});
      if(cue)cue.style.opacity=p>0.05?'0':'0.7';}
  }
  // Bag portal — same, only while it's in view
  if(bagportal){const br=bagportal.getBoundingClientRect();
    if(br.bottom>0 && br.top<innerHeight){
      const bp=clamp(0,1,-br.top/(br.height-innerHeight));
      /* The zipper is the point of this section, so it gets the long middle
         of the scroll to itself: the bag barely moves while it opens, and
         only once it is fully open does the camera dive in. Previously the
         zipper ran from 8% to 38% while the bag was already zooming and
         fading, which made it read as a fast cut rather than an opening. */
      const k=smooth(clamp(0,1,(bp-0.05)/0.57));      // opens 5% -> 62%
      const dive=smooth(clamp(0,1,(bp-0.62)/0.38));
      const z=0.9+smooth(clamp(0,1,bp/0.62))*0.28+Math.pow(dive,1.5)*(ZBAG-1.18);
      bagbig.style.transform='scale('+z.toFixed(3)+')';
      bagbig.style.opacity=(1-smooth(clamp(0,1,(bp-0.8)/0.2))).toFixed(3);
      if(bpcap)bpcap.style.opacity=(1-smooth(clamp(0,1,(bp-0.3)/0.25))).toFixed(3);
      const kq=k.toFixed(3);                          // finer than the old 2dp
      if(kq!==lastK){lastK=kq;
        if(bagslider)bagslider.setAttribute('transform','translate('+(-(k*104)).toFixed(1)+' 0)');
        const fs=1-0.62*k;
        if(bagflap)bagflap.setAttribute('transform','translate(0 '+(368*(1-fs)).toFixed(1)+') scale(1 '+fs.toFixed(3)+')');
        if(bagint)bagint.setAttribute('opacity',clamp(0,1,(k-0.1)/0.5).toFixed(3));
      }
    }
  }
  flDiscParallax(scrollY);
  if(prog){const tot=clamp(0,1,scrollY/(document.documentElement.scrollHeight-innerHeight||1));prog.style.width=(tot*100).toFixed(1)+'%'}
  requestAnimationFrame(loop);
}
if(!REDUCED)requestAnimationFrame(loop);
else{caps.forEach(c=>c.classList.remove('show'));caps[0].classList.add('show');if(l)l.classList.add('done');}

/* ===== reveal ===== */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('in')}),{threshold:.14});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

/* ===== catalog ===== */
const BRAND={
  'Kastaplast':{rim:['#C8E05A','#A9C93B','#7C9A24'],glow:'rgba(180,211,52,.4)',face:['#22301A','#18220F','#0E1408']},
  'Discmania':{rim:['#4A6FD4','#24439B','#152A66'],glow:'rgba(74,111,212,.45)',face:['#101B3E','#0B1330','#070D22']},
  'Latitude 64':{rim:['#FFD34D','#F2B705','#B98603'],glow:'rgba(242,183,5,.35)',face:['#2E2408','#221A05','#141003']},
  'Westside':{rim:['#E06A5A','#C9453B','#8F2A24'],glow:'rgba(224,106,90,.4)',face:['#301A17','#220F0D','#140807']},
  'Dynamic Discs':{rim:['#5AC8E0','#3BA9C9','#247C9A'],glow:'rgba(90,200,224,.4)',face:['#17282E','#0F1B20','#081013']}
};
// 15 discs across the 5 brands, grouped by flight class
const DISCS=[
  {b:'Kastaplast',m:'Reko',c:'Putter',n:[3,3,0,1],h:'kastaplast-reko-putter'},
  {b:'Dynamic Discs',m:'Judge',c:'Putter',n:[2,4,0,1],h:'dynamic-discs-judge-putter'},
  {b:'Discmania',m:'P2',c:'Putter',n:[2,3,0,2],h:'discmania-p2-putter'},
  {b:'Kastaplast',m:'Berg',c:'Approach',n:[1,1,0,2],h:'kastaplast-berg-approach'},
  {b:'Westside',m:'Harp',c:'Approach',n:[4,3,0,3],h:'westside-harp-approach'},
  {b:'Discmania',m:'MD3',c:'Midrange',n:[5,5,0,2],h:'discmania-md3-midrange'},
  {b:'Kastaplast',m:'Lots',c:'Midrange',n:[5,5,-0.5,1.5],h:'kastaplast-lots-midrange'},
  {b:'Latitude 64',m:'Fuse',c:'Midrange',n:[6,6,-1,1],h:'latitude-64-fuse-midrange'},
  {b:'Latitude 64',m:'River',c:'Fairway',n:[7,7,-1,1],h:'latitude-64-river-fairway-driver'},
  {b:'Discmania',m:'FD',c:'Fairway',n:[7,6,-1,1],h:'discmania-fd-fairway-driver'},
  {b:'Westside',m:'Underworld',c:'Fairway',n:[7,6,-3,1],h:'westside-underworld-fairway-driver'},
  {b:'Latitude 64',m:'Ballista Pro',c:'Distanse',n:[14,4,0,3],h:'latitude-64-ballista-pro-distansedriver'},
  {b:'Discmania',m:'DD3',c:'Distanse',n:[13,5,-1,3],h:'discmania-dd3-distansedriver'},
  {b:'Dynamic Discs',m:'Trespass',c:'Distanse',n:[12,5,-0.5,3],h:'dynamic-discs-trespass-distansedriver'},
  {b:'Kastaplast',m:'Grym X',c:'Distanse',n:[12,5,-1,3],h:'kastaplast-grym-x-distansedriver'}
];
const CLASS_ORDER=[['Putter','Puttere','Presisjon og kontroll rundt kurven'],['Approach','Approach','Trygge innspill mot kurven'],['Midrange','Midrange','Allrounderen i bagen'],['Fairway','Fairway-drivere','Kontrollert lengde'],['Distanse','Distansedrivere','Maks meter fra utkastet']];
function disc3(b,m,n){const s=BRAND[b],S=108;
  return '<div class="disc-scene"><div class="disc3d" style="width:'+S+'px;height:'+S+'px">'+
   '<div class="dl" style="background:radial-gradient(circle at 35% 30%,'+s.rim[0]+' 0%,'+s.rim[1]+' 45%,'+s.rim[2]+' 100%);box-shadow:inset 0 2px 5px rgba(255,255,255,.35),inset 0 -4px 8px rgba(0,0,0,.5),0 0 26px '+s.glow+'"></div>'+
   '<div class="dl dface" style="inset:7%;transform:translateZ(6px);background:repeating-radial-gradient(circle at 50% 50%,rgba(255,255,255,.035) 0 1.5px,rgba(0,0,0,.03) 1.5px 6px),radial-gradient(circle at 40% 35%,'+s.face[0]+' 0%,'+s.face[1]+' 60%,'+s.face[2]+' 100%)">'+
   '<div class="dring"></div>'+
   '<span style="font-size:6px;letter-spacing:2px;color:rgba(250,249,245,.75);text-transform:uppercase">'+b+'</span>'+
   '<span style="font-size:14px;color:#faf9f5;font-family:var(--h);font-style:italic;white-space:nowrap;margin-top:2px">'+m+'</span>'+
   '<span style="font-size:7px;letter-spacing:1px;color:rgba(250,249,245,.55);margin-top:3px">'+n.join(' · ')+'</span></div>'+
   '<div class="dl" style="transform:translateZ(7px);background:radial-gradient(ellipse 55% 35% at 30% 22%,rgba(255,255,255,.32),rgba(255,255,255,.06) 45%,transparent 65%)"></div>'+
   '</div></div>';}
/* Prices come from Shopify as window.FL_PRICE, keyed by product handle.
   The flat 179 kr is only a fallback for viewing this file on its own. */
const FLPRICE=(typeof window!=='undefined'&&window.FL_PRICE)||{};
const priceOf=d=>{const p=FLPRICE[d.h];return p&&isFinite(p.amount)?+p.amount:179};
const priceText=d=>{const p=FLPRICE[d.h];return p&&p.text?p.text:'179 kr'};

function card(d){return '<a class="pcard rv" href="/products/'+d.h+'"><div class="dw">'+disc3(d.b,d.m,d.n)+'</div><div class="shadow"></div>'+
  '<h3>'+d.b+' '+d.m+'</h3><span class="cls">'+d.c+'</span><span class="fn">'+d.n.join(' · ')+'</span><span class="pr">'+priceText(d)+'</span></a>';}

/* ---- catalogue filter: brand, type, price ---- */
const F={brand:new Set(),type:new Set(),sort:''};
const groupsEl=document.getElementById('disc-groups');

function renderDiscs(first){
  let items=DISCS.filter(d=>(!F.brand.size||F.brand.has(d.b))&&(!F.type.size||F.type.has(d.c)));
  if(F.sort){
    /* A price sort is global, so the per-class grouping is dropped while
       it is active — otherwise you would only be sorting within a class. */
    items=items.slice().sort((a,b)=>F.sort==='asc'?priceOf(a)-priceOf(b):priceOf(b)-priceOf(a));
    groupsEl.innerHTML=items.length?'<div class="disc-group"><div class="pgrid">'+items.map(card).join('')+'</div></div>':'';
  }else{
    groupsEl.innerHTML=CLASS_ORDER.map(([key,title,sub])=>{
      const g=items.filter(d=>d.c===key);if(!g.length)return '';
      return '<div class="disc-group"><div class="gt rv"><h3>'+title+'</h3><span>'+sub+' · '+g.length+' modeller</span></div>'+
        '<div class="pgrid">'+g.map(card).join('')+'</div></div>';
    }).join('');
  }
  const empty=document.getElementById('fempty');if(empty)empty.hidden=items.length>0;
  const n=F.brand.size+F.type.size+(F.sort?1:0);
  const c=document.getElementById('fcount');if(c){c.hidden=!n;c.textContent=n||''}
  const res=document.getElementById('fres');
  if(res)res.textContent=items.length===DISCS.length?'Viser alle '+DISCS.length+' discer'
    :items.length+' av '+DISCS.length+' discer';
  /* First paint keeps the scroll reveal; later re-renders show at once, so
     filtering does not look like a blank grid. */
  if(first)groupsEl.querySelectorAll('.rv').forEach(el=>io.observe(el));
  else groupsEl.querySelectorAll('.rv').forEach(el=>el.classList.add('in'));
}

(function(){
  const btn=document.getElementById('filterbtn'),panel=document.getElementById('filterpanel');
  if(!btn||!panel){renderDiscs(true);return}
  const chip=(label,v)=>'<button class="fchip" type="button" role="switch" aria-pressed="false" data-v="'+v+'">'+label+'</button>';
  const brands=[...new Set(DISCS.map(d=>d.b))].sort((a,b)=>a.localeCompare(b,'no'));
  document.getElementById('fbrand').innerHTML=brands.map(b=>chip(b,b)).join('');
  document.getElementById('ftype').innerHTML=CLASS_ORDER
    .filter(([k])=>DISCS.some(d=>d.c===k)).map(([k,title])=>chip(title,k)).join('');
  document.getElementById('fprice').innerHTML=chip('Lav til høy','asc')+chip('Høy til lav','desc');

  btn.addEventListener('click',()=>{
    const open=btn.getAttribute('aria-expanded')==='true';
    btn.setAttribute('aria-expanded',String(!open));panel.hidden=open;
  });
  panel.addEventListener('click',e=>{
    const t=e.target.closest('.fchip');
    if(t){
      const v=t.dataset.v,grp=t.parentElement.id;
      if(grp==='fprice'){                       // price is a single choice
        const on=F.sort===v;F.sort=on?'':v;
        [...t.parentElement.children].forEach(c=>c.setAttribute('aria-pressed',String(!on&&c===t)));
      }else{
        const set=grp==='fbrand'?F.brand:F.type;
        if(set.has(v)){set.delete(v);t.setAttribute('aria-pressed','false')}
        else{set.add(v);t.setAttribute('aria-pressed','true')}
      }
      renderDiscs(false);return;
    }
    if(e.target.closest('#fclear'))clearAll();
  });
  document.addEventListener('click',e=>{if(e.target.closest('[data-clear]'))clearAll()});
  function clearAll(){
    F.brand.clear();F.type.clear();F.sort='';
    panel.querySelectorAll('.fchip').forEach(c=>c.setAttribute('aria-pressed','false'));
    renderDiscs(false);
  }
  renderDiscs(true);
})();

// bags (dedicated section)
const BAGS=[
  {img:'https://images.pexels.com/photos/5202030/pexels-photo-5202030.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Flightlab Sling',d:'6–8 discer · lett for en rask runde',p:'299 kr',h:'flightlab-sling'},
  {img:'https://images.pexels.com/photos/1178521/pexels-photo-1178521.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Flightlab Starter Bag',d:'8–10 discer · flaskeholder',p:'349 kr',h:'flightlab-starter-bag'},
  {img:'https://images.pexels.com/photos/2422461/pexels-photo-2422461.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Flightlab Coursebag',d:'18+ discer, stativ og drikkeflaske',p:'699 kr',h:'flightlab-coursebag'},
  {img:'https://images.pexels.com/photos/1103829/pexels-photo-1103829.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Flightlab Tour Backpack',d:'25+ discer · innebygd stativ · værsikker',p:'1 099 kr',h:'flightlab-tour-backpack'}
];
// accessories
const ACC=[
  {img:'https://images.pexels.com/photos/12370410/pexels-photo-12370410.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Startsett — 3 Discer',d:'Putter, midrange og driver i én pakke',p:'349 kr',h:'startsett-3-discer'},
  {img:'https://images.pexels.com/photos/5038791/pexels-photo-5038791.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Disc-Håndkle',d:'Tørt grep i regn og morgendugg',p:'149 kr',h:'disc-handkle'},
  {img:'https://images.pexels.com/photos/1325711/pexels-photo-1325711.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Flightlab Drikkeflaske',d:'750 ml, kald drikke hele runden',p:'129 kr',h:'flightlab-drikkeflaske'},
  {img:'https://images.pexels.com/photos/1103970/pexels-photo-1103970.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Flightlab Caps',d:'Pustende caps med brodert logo',p:'199 kr',h:'flightlab-caps'},
  {img:'https://images.pexels.com/photos/9072316/pexels-photo-9072316.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Mini-markør',d:'Merk liet ditt — metall med logo',p:'49 kr',h:'mini-markor'},
  {img:'https://images.pexels.com/photos/4219654/pexels-photo-4219654.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Scorekort-holder',d:'Vær­sikker holder med blyant',p:'99 kr',h:'scorekort-holder'},
  {img:'https://images.pexels.com/photos/9072311/pexels-photo-9072311.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Flightlab Hettegenser',d:'Myk collegegenser i skoggrønn',p:'549 kr',h:'flightlab-hettegenser'},
  {img:'https://images.pexels.com/photos/6311392/pexels-photo-6311392.jpeg?auto=compress&cs=tinysrgb&w=700',n:'Øvingskurv',d:'Bærbar kurv for putt-trening hjemme',p:'899 kr',h:'ovingskurv'}
];
/* Image source, in priority order:
   1. window.FL_IMG[handle] — set by Shopify (theme setting, else product photo)
   2. the built-in placeholder below
   Lets the shop owner swap any card image from Theme settings without code. */
const FLIMG=(typeof window!=='undefined'&&window.FL_IMG)||{};
const imgFor=a=>FLIMG[a.h]||a.img;
const acard=a=>'<a class="acard rv" href="/products/'+a.h+'"><div class="im"><img src="'+imgFor(a)+'" alt="'+a.n+'" loading="lazy" onerror="this.style.display=\'none\'"></div>'+
  '<div class="bd"><h4>'+a.n+'</h4><div class="ad">'+a.d+'</div><div class="ap">'+a.p+'</div></div></a>';
if(window.FL_HERO){const hd=document.getElementById('herodisc');if(hd)hd.src=window.FL_HERO;}
document.getElementById('bgrid').innerHTML=BAGS.map(acard).join('');
document.getElementById('agrid').innerHTML=ACC.map(acard).join('');
document.querySelectorAll('#disc-groups .rv,#bgrid .rv,#agrid .rv').forEach(el=>io.observe(el));

document.getElementById('nlform').addEventListener('submit',e=>{e.preventDefault();
  const f=e.target;if(f.querySelector('input').value.trim()){f.outerHTML='<div class="nlthanks">Takk! Vi sier ifra så fort dørene åpner. 🥏</div>'}});

/* ===== catalogue search: live filter here, full-store search on submit ===== */
(function(){
  const q=document.getElementById('q'),hint=document.getElementById('searchhint');
  if(!q)return;
  const secs=['discer','bager','tilbehor'].map(id=>document.getElementById(id)).filter(Boolean);
  const bp=document.getElementById('bagportal');
  function run(){
    const term=q.value.trim().toLowerCase();
    const cards=document.querySelectorAll('#disc-groups .pcard,#bgrid .acard,#agrid .acard');
    let shown=0;
    cards.forEach(c=>{const hit=!term||c.textContent.toLowerCase().includes(term);c.style.display=hit?'':'none';if(hit&&term)shown++;});
    document.querySelectorAll('#disc-groups .disc-group').forEach(g=>{
      g.style.display=[...g.querySelectorAll('.pcard')].some(c=>c.style.display!=='none')?'':'none';});
    if(term){
      secs.forEach(s=>{const any=[...s.querySelectorAll('.pcard,.acard')].some(c=>c.style.display!=='none');s.style.display=any?'':'none';});
      if(bp)bp.style.display='none';
      hint.className='searchhint on';
      hint.innerHTML=shown+' treff · <a href="#discer">Vis ↓</a> · <a href="/search?q='+encodeURIComponent(q.value)+'">Hele butikken →</a>';
    }else{
      secs.forEach(s=>s.style.display='');if(bp)bp.style.display='';hint.className='searchhint';hint.innerHTML='';
    }
  }
  q.addEventListener('input',run);
})();

/* ===== Apple-style press feedback (pointer-based so iOS Safari honours it) ===== */
(function(){
  const SEL='.pcard,.acard,.btn,nav .nl a,.brand,.filterbtn,.fchip';
  addEventListener('pointerdown',e=>{const t=e.target.closest(SEL);if(t)t.classList.add('pressing');},{passive:true});
  const clear=()=>document.querySelectorAll('.pressing').forEach(el=>el.classList.remove('pressing'));
  ['pointerup','pointercancel','pointerleave','dragstart','scroll'].forEach(ev=>addEventListener(ev,clear,{passive:true}));
})();
</script>

