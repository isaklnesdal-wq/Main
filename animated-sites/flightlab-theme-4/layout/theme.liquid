<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_paper }}">
  <meta name="color-scheme" content="dark">

  <title>
    {{- page_title -}}
    {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; Side {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'sections.css' | asset_url | stylesheet_tag }}
  {{ 'commerce.css' | asset_url | stylesheet_tag }}
  {%- comment -%} Experiment: dark treatment, loaded last so it only re-tones. {%- endcomment -%}
  {{ 'premium-dark.css' | asset_url | stylesheet_tag }}

  <script>document.documentElement.classList.replace('no-js', 'js');</script>

  {% render 'structured-data' %}

  {{ content_for_header }}

  <style>
    :root {
      --color-paper: {{ settings.color_paper | default: '#0D1117' }};
      --color-forest: {{ settings.color_forest | default: '#151A22' }};
      --color-forest-deep: {{ settings.color_forest_deep | default: '#0D1117' }};
      --color-signal: {{ settings.color_signal | default: '#3ECF8E' }};
    }
  </style>
</head>

<body class="template-{{ template.name | handle }}">
  <a class="skip-link" href="#main-content">Hopp til innholdet</a>

  {% sections 'header-group' %}

  <main id="main-content" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'cart-drawer' %}

  <script src="{{ 'global.js' | asset_url }}" defer></script>
</body>
</html>
